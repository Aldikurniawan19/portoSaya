---
import { Image } from 'astro:assets';
import logoPorto from '../assets/LogoPorto.png';
import { getTranslations } from '../i18n/translations';
const currentLang = Astro.currentLocale || 'id';
const t = getTranslations(currentLang);
---

<!-- NAVBAR CONTAINER -->
<!-- Mobile: Fixed Bottom Floating Icon Dock | Desktop: Top Floating Glass Navbar -->
<div class="fixed w-full bottom-4 sm:bottom-5 md:bottom-auto md:top-6 left-0 z-50 flex justify-center px-3 sm:px-6 pointer-events-none pb-[env(safe-area-inset-bottom,0.5rem)]">
  <nav
    class="nav-3d-shell pointer-events-auto w-[92vw] max-w-[420px] md:w-fit rounded-full transition-all duration-300 px-3 sm:px-4 md:px-4 py-2 sm:py-2.5 md:py-2"
    id="navbar"
  >
    <div class="flex items-center justify-between md:justify-start w-full md:w-auto gap-1.5 sm:gap-2">
      <!-- Logo (Visible ONLY on Desktop, Hidden on Mobile Bottom Navbar) -->
      <div class="nav-logo-3d hidden md:flex items-center justify-center cursor-pointer group h-10 px-3 shrink-0 rounded-full transition-all duration-300 hover:scale-105" id="logo-btn" title="Aldi Kurniawan">
        <Image src={logoPorto} alt="Logo" class="h-6 sm:h-7 w-auto object-contain" />
      </div>

      <!-- Left Divider (Visible ONLY on Desktop) -->
      <div class="nav-divider hidden md:block h-5 w-[1.5px] shrink-0"></div>

      <!-- Navigation Links (Evenly spaced & Large Touch Size on Mobile, Icon Only) -->
      <div class="flex items-center justify-between md:justify-start flex-1 md:flex-initial gap-1 sm:gap-1.5" id="nav-links-container">
        <a href="#home" class="nav-link h-11 w-11 sm:h-12 sm:w-12 md:h-10 md:w-auto px-0 md:px-3.5 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200 shrink-0" title={t.navbar.home}>
          <i data-lucide="home" class="w-5.5 h-5.5 md:w-4.5 md:h-4.5 shrink-0"></i>
          <span class="nav-label hidden md:inline text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.home}</span>
        </a>
        <a href="#about" class="nav-link h-11 w-11 sm:h-12 sm:w-12 md:h-10 md:w-auto px-0 md:px-3.5 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200 shrink-0" title={t.navbar.about}>
          <i data-lucide="user" class="w-5.5 h-5.5 md:w-4.5 md:h-4.5 shrink-0"></i>
          <span class="nav-label hidden md:inline text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.about}</span>
        </a>
        <a href="#experience" class="nav-link h-11 w-11 sm:h-12 sm:w-12 md:h-10 md:w-auto px-0 md:px-3.5 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200 shrink-0" title={t.navbar.experience}>
          <i data-lucide="briefcase" class="w-5.5 h-5.5 md:w-4.5 md:h-4.5 shrink-0"></i>
          <span class="nav-label hidden md:inline text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.experience}</span>
        </a>
        <a href="#portfolio" class="nav-link h-11 w-11 sm:h-12 sm:w-12 md:h-10 md:w-auto px-0 md:px-3.5 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200 shrink-0" title={t.navbar.portfolio}>
          <i data-lucide="folder" class="w-5.5 h-5.5 md:w-4.5 md:h-4.5 shrink-0"></i>
          <span class="nav-label hidden md:inline text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.portfolio}</span>
        </a>
        <a href="#contact" class="nav-link h-11 w-11 sm:h-12 sm:w-12 md:h-10 md:w-auto px-0 md:px-3.5 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200 shrink-0" title={t.navbar.contact}>
          <i data-lucide="mail" class="w-5.5 h-5.5 md:w-4.5 md:h-4.5 shrink-0"></i>
          <span class="nav-label hidden md:inline text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.contact}</span>
        </a>
      </div>

      <!-- Right Divider -->
      <div class="nav-divider block h-6 sm:h-7 md:h-5 w-[1.5px] shrink-0 mx-0.5 sm:mx-1"></div>

      <!-- Language Switcher Button (Fixed Circular Button on Mobile) -->
      <a
        href={currentLang === 'id' ? '/en/' : '/'}
        class="btn-3d-light h-11 w-11 sm:h-12 sm:w-12 md:h-10 md:w-auto !p-0 md:!px-3.5 !text-xs md:!text-sm !font-bold transition-all duration-200 group shrink-0 rounded-full flex items-center justify-center"
        title={currentLang === 'id' ? 'Switch to English' : 'Ganti ke Bahasa Indonesia'}
      >
        <span class="font-extrabold tracking-wide uppercase text-xs text-blue-600 md:hidden">{currentLang === 'id' ? 'ID' : 'EN'}</span>
        <div class="hidden md:flex items-center gap-1.5">
          <i data-lucide="globe" class="w-4 h-4 text-blue-600 group-hover:rotate-12 transition-transform duration-300"></i>
          <span class="font-extrabold tracking-wide uppercase">{currentLang === 'id' ? 'ID' : 'EN'}</span>
        </div>
      </a>
    </div>
  </nav>
</div>

<script>
  function initNavbarScrollSpy() {
    const navbar = document.getElementById("navbar");
    const logoBtn = document.getElementById("logo-btn");

    // Logo scroll to top (Desktop)
    logoBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const sections = Array.from(document.querySelectorAll("section"));
    const navLinks = Array.from(document.querySelectorAll(".nav-link"));
    if (sections.length === 0 || navLinks.length === 0) return;

    let ticking = false;

    function updateNav() {
      const validNavIds = ["home", "about", "experience", "portfolio", "contact"];
      const scrollY = window.scrollY;
      let current = "home";

      for (let i = 0; i < sections.length; i++) {
        const section = sections[i];
        const id = section.getAttribute("id") || "";
        if (validNavIds.includes(id)) {
          if (scrollY >= section.offsetTop - 180) {
            current = id;
          }
        }
      }

      if (scrollY < 80) current = "home";

      navLinks.forEach((link) => {
        const targetSection = link.getAttribute("href");
        if (targetSection === "#" + current) {
          link.classList.add("active");
        } else {
          link.classList.remove("active");
        }
      });

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateNav);
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    updateNav();
  }

  initNavbarScrollSpy();
  document.addEventListener("astro:page-load", initNavbarScrollSpy);
</script>

<style is:global>
  /* 3D Convex Navbar Shell */
  .nav-3d-shell {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(248, 250, 252, 0.94) 45%, rgba(241, 245, 249, 0.96) 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-top: 1.5px solid rgba(255, 255, 255, 1);
    border-bottom: 2px solid rgba(203, 213, 225, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 
      inset 0 2.5px 3px 0 rgba(255, 255, 255, 1),
      inset 0 -2.5px 3.5px 0 rgba(0, 0, 0, 0.05),
      0 12px 35px -5px rgba(15, 23, 42, 0.14),
      0 4px 10px -2px rgba(15, 23, 42, 0.06);
  }

  /* 3D Embossed Logo Plate (Desktop) */
  .nav-logo-3d:hover {
    background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 60%, #e2e8f0 100%);
    box-shadow: 
      inset 0 1.5px 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.06),
      0 3px 8px -2px rgba(15, 23, 42, 0.08);
  }

  /* 3D Divider */
  .nav-divider {
    background: linear-gradient(180deg, rgba(203, 213, 225, 0.3) 0%, rgba(203, 213, 225, 0.9) 50%, rgba(203, 213, 225, 0.3) 100%);
    box-shadow: 1px 0 0 rgba(255, 255, 255, 0.9);
  }

  /* Inactive nav links */
  .nav-link {
    color: #475569;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover:not(.active) {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 50%, #eef2f6 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 1);
    box-shadow: 
      inset 0 1.5px 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.05),
      0 3px 8px -2px rgba(15, 23, 42, 0.08);
    color: #0f172a;
    transform: translateY(-1px);
  }

  /* Active nav link (Fixed Size, Convex 3D Highlight, No Layout Shifts) */
  .nav-link.active {
    background: linear-gradient(180deg, #4d8df7 0%, #2b6cef 45%, #1d4ed8 100%) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    border-top: 1.5px solid rgba(255, 255, 255, 0.75) !important;
    border-bottom: 2px solid rgba(10, 30, 95, 0.45) !important;
    box-shadow: 
      inset 0 2.5px 3px 0 rgba(255, 255, 255, 0.7),
      inset 0 -2.5px 3.5px 0 rgba(10, 30, 95, 0.45),
      0 6px 18px -2px rgba(37, 99, 235, 0.45) !important;
    text-shadow: 0 1px 2px rgba(10, 35, 90, 0.35);
    transform: translateY(-0.5px);
  }

  .nav-link.active i,
  .nav-link.active svg {
    color: #ffffff !important;
    stroke: #ffffff !important;
  }
</style>

---
import { Image } from 'astro:assets';
import logoPorto from '../assets/LogoPorto.png';
import { getTranslations } from '../i18n/translations';
const currentLang = Astro.currentLocale || 'id';
const t = getTranslations(currentLang);
---

<!-- NAVBAR CONTAINER -->
<!-- Mobile/Tablet (<1024px): Fixed Bottom Floating Icon Dock | Desktop (>=1024px): Top Floating Glass Navbar -->
<div class="fixed w-full bottom-4 sm:bottom-5 lg:bottom-auto lg:top-6 left-0 z-50 flex justify-center px-2.5 sm:px-4 lg:px-6 pointer-events-none pb-[env(safe-area-inset-bottom,0.75rem)]">
  <nav
    class="nav-3d-shell pointer-events-auto w-[96vw] max-w-[460px] lg:w-auto lg:max-w-none rounded-full transition-all duration-300 px-2 sm:px-3 lg:px-4 py-2 sm:py-2.5 lg:py-2"
    id="navbar"
  >
    <div class="flex items-center justify-between lg:justify-start w-full lg:w-auto gap-1 sm:gap-1.5 lg:gap-2">
      <!-- Logo (Visible ONLY on Desktop, Hidden on Mobile/Tablet Bottom Navbar) -->
      <div class="nav-logo-3d hidden lg:flex items-center justify-center cursor-pointer group h-10 px-3 shrink-0 rounded-full transition-all duration-300 hover:scale-105" id="logo-btn" title="Aldi Kurniawan">
        <Image src={logoPorto} alt="Logo" class="h-6 lg:h-7 w-auto object-contain" />
      </div>

      <!-- Left Divider (Visible ONLY on Desktop) -->
      <div class="nav-divider hidden lg:block h-5 w-[1.5px] shrink-0"></div>

      <!-- Navigation Links (Evenly spaced & Large Touch Size on Mobile, Icon Only) -->
      <div class="relative flex items-center justify-between lg:justify-start flex-1 lg:flex-initial gap-0.5 sm:gap-1 lg:gap-1.5" id="nav-links-container">
        <!-- Fluid / Liquid Sliding Pill Indicator (Indikator Kapsul Cairan Mengalir) -->
        <div
          id="nav-liquid-pill"
          class="nav-liquid-pill pointer-events-none absolute select-none opacity-0 will-change-transform"
          aria-hidden="true"
        >
          <div class="liquid-pill-body">
            <!-- Liquid Specular Top Surface Reflection (Glossy Meniscus) -->
            <div class="liquid-pill-specular"></div>
            <!-- Liquid Caustic Bottom Glow -->
            <div class="liquid-pill-caustic"></div>
          </div>
          <!-- Ambient Liquid Glow Droplet Behind -->
          <div class="liquid-pill-glow"></div>
        </div>

        <a href="#home" class="nav-link h-10 w-10 sm:h-11 sm:w-11 lg:h-10 lg:w-auto px-0 lg:px-3.5 flex items-center justify-center text-slate-600 dark:text-slate-400 rounded-full transition-all duration-200 shrink-0" title={t.navbar.home}>
          <i data-lucide="home" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 shrink-0"></i>
          <span class="nav-label hidden lg:inline text-xs lg:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.home}</span>
        </a>
        <a href="#about" class="nav-link h-10 w-10 sm:h-11 sm:w-11 lg:h-10 lg:w-auto px-0 lg:px-3.5 flex items-center justify-center text-slate-600 dark:text-slate-400 rounded-full transition-all duration-200 shrink-0" title={t.navbar.about}>
          <i data-lucide="user" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 shrink-0"></i>
          <span class="nav-label hidden lg:inline text-xs lg:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.about}</span>
        </a>
        <a href="#experience" class="nav-link h-10 w-10 sm:h-11 sm:w-11 lg:h-10 lg:w-auto px-0 lg:px-3.5 flex items-center justify-center text-slate-600 dark:text-slate-400 rounded-full transition-all duration-200 shrink-0" title={t.navbar.experience}>
          <i data-lucide="briefcase" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 shrink-0"></i>
          <span class="nav-label hidden lg:inline text-xs lg:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.experience}</span>
        </a>
        <a href="#portfolio" class="nav-link h-10 w-10 sm:h-11 sm:w-11 lg:h-10 lg:w-auto px-0 lg:px-3.5 flex items-center justify-center text-slate-600 dark:text-slate-400 rounded-full transition-all duration-200 shrink-0" title={t.navbar.portfolio}>
          <i data-lucide="folder" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 shrink-0"></i>
          <span class="nav-label hidden lg:inline text-xs lg:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.portfolio}</span>
        </a>
        <a href="#contact" class="nav-link h-10 w-10 sm:h-11 sm:w-11 lg:h-10 lg:w-auto px-0 lg:px-3.5 flex items-center justify-center text-slate-600 dark:text-slate-400 rounded-full transition-all duration-200 shrink-0" title={t.navbar.contact}>
          <i data-lucide="mail" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 shrink-0"></i>
          <span class="nav-label hidden lg:inline text-xs lg:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.contact}</span>
        </a>
      </div>

      <!-- Right Divider -->
      <div class="nav-divider block h-6 sm:h-7 lg:h-5 w-[1.5px] shrink-0 mx-0.5 sm:mx-1"></div>

      <!-- Right Action Controls (Language Switcher + Theme Toggle) -->
      <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
        <!-- Language Switcher Button (Globe Icon with Special Badge on Mobile/Tablet Dock, Globe + Text on Desktop) -->
        <a
          href={currentLang === 'id' ? '/en/' : '/'}
          class="btn-3d-light relative h-10 w-10 sm:h-11 sm:w-11 lg:h-10 lg:w-auto !p-0 lg:!px-3.5 !text-xs lg:!text-sm !font-bold transition-all duration-200 group shrink-0 rounded-full flex items-center justify-center gap-1.5"
          title={currentLang === 'id' ? 'Ganti Bahasa ke English' : 'Ganti ke Bahasa Indonesia'}
          aria-label={currentLang === 'id' ? 'Ganti Bahasa ke English' : 'Ganti ke Bahasa Indonesia'}
        >
          <i data-lucide="globe" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 text-blue-600 dark:text-blue-400 group-hover:rotate-12 transition-transform duration-300 shrink-0"></i>
          
          <!-- Deskripsi Khusus (Badge Indikator Bahasa) untuk Mobile Bottombar -->
          <span class="absolute -top-1 -right-1 flex lg:hidden items-center justify-center bg-blue-600 text-white text-[8px] font-black px-1.5 py-0.5 rounded-full shadow-sm border border-white dark:border-slate-800 leading-none tracking-tight">
            {currentLang === 'id' ? 'ID' : 'EN'}
          </span>

          <!-- Label Teks untuk Desktop Navbar -->
          <span class="font-extrabold tracking-wide uppercase hidden lg:inline">{currentLang === 'id' ? 'ID' : 'EN'}</span>
        </a>

        <!-- Theme Switcher Button (Light / Dark Mode Toggle) -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="btn-3d-light relative h-10 w-10 sm:h-11 sm:w-11 lg:h-10 lg:w-10 !p-0 !text-xs !font-bold transition-all duration-200 group shrink-0 rounded-full flex items-center justify-center cursor-pointer"
          title={t.navbar.themeToggle}
          aria-label={t.navbar.themeToggle}
        >
          <!-- Sun Icon (Rendered in Dark mode -> click to switch to light) -->
          <i data-lucide="sun" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 text-amber-400 group-hover:rotate-45 transition-transform duration-300 hidden dark:block shrink-0 drop-shadow-[0_0_8px_rgba(251,191,36,0.6)]"></i>
          <!-- Moon Icon (Rendered in Light mode -> click to switch to dark) -->
          <i data-lucide="moon" class="w-5 h-5 sm:w-5.5 sm:h-5.5 lg:w-4.5 lg:h-4.5 text-indigo-600 group-hover:-rotate-12 transition-transform duration-300 block dark:hidden shrink-0"></i>
        </button>
      </div>
    </div>
  </nav>
</div>

<script>
  function initNavbarScrollSpy() {
    const logoBtn = document.getElementById("logo-btn");
    const navContainer = document.getElementById("nav-links-container") as HTMLElement;
    const pill = document.getElementById("nav-liquid-pill") as HTMLElement;

    // Logo scroll to top (Desktop)
    logoBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const sections = Array.from(document.querySelectorAll("section"));
    const navLinks = Array.from(document.querySelectorAll(".nav-link")) as HTMLElement[];
    if (!navContainer || !pill || sections.length === 0 || navLinks.length === 0) return;

    // Fluid Directional Sliding Pill Controller
    let currentX = 0;
    let currentY = 0;
    let currentW = 0;
    let currentH = 0;
    let currentActiveLink: HTMLElement | null = null;
    let animId: number | null = null;
    let isInitialized = false;
    let isUserClicking = false;
    let clickTimeout: number | null = null;

    function animatePillTo(targetLink: HTMLElement, isImmediate = false) {
      if (!targetLink || !pill || !navContainer) return;

      const containerRect = navContainer.getBoundingClientRect();
      const targetRect = targetLink.getBoundingClientRect();

      const targetX = targetRect.left - containerRect.left;
      const targetY = targetRect.top - containerRect.top;
      const targetW = targetRect.width;
      const targetH = targetRect.height;

      // Immediate snap (initial page load or window resize)
      if (isImmediate || !isInitialized) {
        if (animId) cancelAnimationFrame(animId);
        animId = null;
        currentX = targetX;
        currentY = targetY;
        currentW = targetW;
        currentH = targetH;
        currentActiveLink = targetLink;
        pill.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) scale(1, 1) skewX(0deg)`;
        pill.style.width = `${currentW}px`;
        pill.style.height = `${currentH}px`;
        pill.style.opacity = "1";
        pill.style.filter = "none";
        isInitialized = true;
        return;
      }

      // Check distance in menu steps
      const prevIndex = currentActiveLink ? navLinks.indexOf(currentActiveLink) : -1;
      const nextIndex = navLinks.indexOf(targetLink);
      const stepCount = (prevIndex >= 0 && nextIndex >= 0) ? Math.abs(nextIndex - prevIndex) : 1;
      const isMultiStep = stepCount >= 2;

      currentActiveLink = targetLink;

      const startX = currentX;
      const startY = currentY;
      const startW = currentW;
      const startH = currentH;

      const deltaX = targetX - startX;
      if (Math.abs(deltaX) < 0.5 && Math.abs(targetW - startW) < 0.5) {
        currentX = targetX;
        currentY = targetY;
        currentW = targetW;
        currentH = targetH;
        pill.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) scale(1, 1) skewX(0deg)`;
        pill.style.width = `${currentW}px`;
        pill.style.height = `${currentH}px`;
        pill.style.opacity = "1";
        pill.style.filter = "none";
        return;
      }

      // Direction: strictly follows where the destination menu is (+1 right, -1 left)
      const direction = deltaX > 0 ? 1 : -1;
      const duration = isMultiStep ? 380 : 280;
      const startTime = performance.now();

      if (animId) cancelAnimationFrame(animId);

      function step(now: number) {
        const elapsed = now - startTime;
        const p = Math.min(elapsed / duration, 1);

        // Monotonic ease-out quartic: strictly moves in direction of target, ZERO bounce-back
        const ease = 1 - Math.pow(1 - p, 4);

        // Position advances strictly in destination direction
        currentX = startX + deltaX * ease;
        currentY = startY + (targetY - startY) * ease;
        currentW = startW + (targetW - startW) * ease;
        currentH = startH + (targetH - startH) * ease;

        // Dynamic fluid elongation in motion direction (peaks mid-flight, zero at start and end)
        const flightArch = Math.sin(p * Math.PI);
        const stretchAmount = isMultiStep ? 0.22 : 0.14;
        const stretchX = 1 + flightArch * stretchAmount;
        const squashY = 1 / Math.sqrt(stretchX);

        // Fluid droplet tilt in travel direction
        const skewX = -direction * flightArch * (isMultiStep ? 5 : 3.5);

        // When crossing multiple menus: smoothly fade out like passing through (memudar seperti melintasi)
        let opacityVal = 1;
        let blurVal = 0;
        if (isMultiStep) {
          opacityVal = 1 - flightArch * 0.52; // Fades to ~0.48 while crossing
          blurVal = flightArch * 1.8; // Soft motion blur while gliding through
        }

        pill.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) scale(${stretchX}, ${squashY}) skewX(${skewX}deg)`;
        pill.style.width = `${currentW}px`;
        pill.style.height = `${currentH}px`;
        pill.style.opacity = `${opacityVal}`;
        pill.style.filter = blurVal > 0.2 ? `blur(${blurVal}px)` : "none";

        if (p < 1) {
          animId = requestAnimationFrame(step);
        } else {
          // Final landing state: solid, perfectly aligned, zero distortion
          currentX = targetX;
          currentY = targetY;
          currentW = targetW;
          currentH = targetH;
          pill.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) scale(1, 1) skewX(0deg)`;
          pill.style.width = `${currentW}px`;
          pill.style.height = `${currentH}px`;
          pill.style.opacity = "1";
          pill.style.filter = "none";
          animId = null;
        }
      }

      animId = requestAnimationFrame(step);
    }

    // ScrollSpy & Navigation Tracking
    let lastActiveId = "";
    let ticking = false;

    function updateNav() {
      if (isUserClicking) return;

      const validNavIds = ["home", "about", "experience", "portfolio", "contact"];
      const scrollY = window.scrollY;
      const viewportHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      let current = "home";

      // 1. If at the top of the page
      if (scrollY < 80) {
        current = "home";
      }
      // 2. If scrolled near the bottom of page (activate Contact)
      else if ((window.innerHeight + scrollY) >= docHeight - 80) {
        current = "contact";
      }
      // 3. Section position based on getBoundingClientRect (reliable across any parent positioning)
      else {
        // Trigger threshold: 38% of viewport height
        const threshold = viewportHeight * 0.38;
        for (let i = 0; i < sections.length; i++) {
          const section = sections[i];
          const id = section.getAttribute("id") || "";
          if (validNavIds.includes(id)) {
            const rect = section.getBoundingClientRect();
            if (rect.top <= threshold) {
              current = id;
            }
          }
        }
      }

      if (current !== lastActiveId || !isInitialized) {
        lastActiveId = current;
        navLinks.forEach((link) => {
          const targetSection = link.getAttribute("href");
          if (targetSection === "#" + current) {
            link.classList.add("active");
            animatePillTo(link, !isInitialized);
          } else {
            link.classList.remove("active");
          }
        });
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          updateNav();
        });
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    
    // Unlock immediately on manual user gestures so scroll is never blocked
    window.addEventListener("wheel", () => {
      if (isUserClicking) {
        isUserClicking = false;
        if (clickTimeout) clearTimeout(clickTimeout);
      }
    }, { passive: true });

    window.addEventListener("touchmove", () => {
      if (isUserClicking) {
        isUserClicking = false;
        if (clickTimeout) clearTimeout(clickTimeout);
      }
    }, { passive: true });

    window.addEventListener("resize", () => {
      const activeLink = document.querySelector(".nav-link.active") as HTMLElement;
      if (activeLink) {
        animatePillTo(activeLink, true);
      }
    });

    // Handle instant click reaction with directional glide & scrollspy lock
    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          const id = href.slice(1);
          lastActiveId = id;
          navLinks.forEach((l) => l.classList.remove("active"));
          link.classList.add("active");

          // Temporarily lock scrollspy from fighting while page smoothly scrolls
          isUserClicking = true;
          if (clickTimeout) clearTimeout(clickTimeout);
          clickTimeout = window.setTimeout(() => {
            isUserClicking = false;
            updateNav();
          }, 650);

          animatePillTo(link, false);
        }
      });
    });

    // Initialize position immediately
    updateNav();
    // Safety calibrate after fonts/layout settles
    setTimeout(() => {
      const activeLink = document.querySelector(".nav-link.active") as HTMLElement;
      if (activeLink) {
        animatePillTo(activeLink, true);
      }
    }, 150);
  }

  function initThemeToggle() {
    const themeBtn = document.getElementById("theme-toggle-btn");
    if (!themeBtn) return;

    themeBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      }

      // Re-create icons if Lucide is available
      if (typeof (window as any).lucide !== "undefined") {
        (window as any).lucide.createIcons();
      }
    });
  }

  function initNavbarModules() {
    initNavbarScrollSpy();
    initThemeToggle();
  }

  initNavbarModules();
  document.addEventListener("astro:page-load", initNavbarModules);
</script>

<style is:global>
  /* 3D Convex Navbar Shell */
  .nav-3d-shell {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(248, 250, 252, 0.94) 45%, rgba(241, 245, 249, 0.96) 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-top: 1.5px solid rgba(255, 255, 255, 1);
    border-bottom: 2px solid rgba(203, 213, 225, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 
      inset 0 2.5px 3px 0 rgba(255, 255, 255, 1),
      inset 0 -2.5px 3.5px 0 rgba(0, 0, 0, 0.05),
      0 12px 35px -5px rgba(15, 23, 42, 0.14),
      0 4px 10px -2px rgba(15, 23, 42, 0.06);
  }

  html.dark .nav-3d-shell {
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.95) 0%, rgba(11, 18, 33, 0.92) 50%, rgba(8, 13, 24, 0.96) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1.5px solid rgba(255, 255, 255, 0.25);
    border-bottom: 2px solid rgba(0, 0, 0, 0.7);
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.15),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.6),
      0 12px 35px -5px rgba(0, 0, 0, 0.6),
      0 4px 10px -2px rgba(0, 0, 0, 0.4);
  }

  /* 3D Embossed Logo Plate (Desktop) */
  .nav-logo-3d:hover {
    background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 60%, #e2e8f0 100%);
    box-shadow: 
      inset 0 1.5px 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.06),
      0 3px 8px -2px rgba(15, 23, 42, 0.08);
  }

  html.dark .nav-logo-3d:hover {
    background: linear-gradient(180deg, #1e293b 0%, #152033 60%, #0f172a 100%);
    box-shadow: 
      inset 0 1.5px 1.5px 0 rgba(255, 255, 255, 0.15),
      inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.5),
      0 3px 8px -2px rgba(0, 0, 0, 0.4);
  }

  /* 3D Divider */
  .nav-divider {
    background: linear-gradient(180deg, rgba(203, 213, 225, 0.3) 0%, rgba(203, 213, 225, 0.9) 50%, rgba(203, 213, 225, 0.3) 100%);
    box-shadow: 1px 0 0 rgba(255, 255, 255, 0.9);
  }

  html.dark .nav-divider {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0.05) 100%);
    box-shadow: 1px 0 0 rgba(0, 0, 0, 0.5);
  }

  /* ========================================================
     FLUID / LIQUID SLIDING PILL INDICATOR
     ======================================================== */
  .nav-liquid-pill {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 1;
    transform-origin: 50% 50%;
    will-change: transform, width, height, opacity, filter;
  }

  .liquid-pill-body {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background: linear-gradient(180deg, #4d8df7 0%, #2b6cef 45%, #1d4ed8 100%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.8),
      inset 0 -2.5px 3.5px 0 rgba(10, 30, 95, 0.5),
      0 6px 18px -2px rgba(29, 78, 216, 0.5),
      0 2px 6px rgba(15, 23, 42, 0.2);
    overflow: hidden;
  }

  html.dark .liquid-pill-body {
    background: linear-gradient(180deg, #3b82f6 0%, #2563eb 45%, #1d4ed8 100%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-top: 1.5px solid rgba(255, 255, 255, 0.8);
    box-shadow: 
      inset 0 2px 3px 0 rgba(255, 255, 255, 0.8),
      inset 0 -2.5px 3.5px 0 rgba(10, 30, 95, 0.6),
      0 8px 22px -2px rgba(37, 99, 235, 0.65),
      0 0 12px 1px rgba(96, 165, 250, 0.4);
  }

  /* Liquid Meniscus & Specular Fluid Glare (Tetesan Cairan Berkilau) */
  .liquid-pill-specular {
    position: absolute;
    inset-x: 3px;
    top: 1.5px;
    height: 44%;
    border-radius: 9999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.35) 65%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
  }

  /* Liquid Caustic Subsurface Bottom Glow */
  .liquid-pill-caustic {
    position: absolute;
    inset-x: 5px;
    bottom: 1.5px;
    height: 32%;
    border-radius: 9999px;
    background: linear-gradient(0deg, rgba(147, 197, 253, 0.5) 0%, rgba(147, 197, 253, 0) 100%);
    pointer-events: none;
  }

  /* Ambient Liquid Glow Droplet Behind */
  .liquid-pill-glow {
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    background: radial-gradient(ellipse at center, rgba(37, 99, 235, 0.55) 0%, rgba(37, 99, 235, 0) 75%);
    filter: blur(6px);
    z-index: -1;
    pointer-events: none;
  }

  /* Inactive nav links */
  .nav-link {
    color: #475569;
    flex-shrink: 0;
    transition: color 0.25s ease, transform 0.25s ease;
    position: relative;
    z-index: 10;
  }

  html.dark .nav-link {
    color: #94a3b8;
  }

  .nav-link:hover:not(.active) {
    color: #0f172a;
    transform: translateY(-1px);
  }

  html.dark .nav-link:hover:not(.active) {
    color: #f8fafc;
    transform: translateY(-1px);
  }

  /* Active nav link (Transparent background because #nav-liquid-pill is behind it) */
  .nav-link.active {

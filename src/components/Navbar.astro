---
import { Image } from 'astro:assets';
import logoPorto from '../assets/LogoPorto.png';
import { getTranslations } from '../i18n/translations';
const currentLang = Astro.currentLocale || 'id';
const t = getTranslations(currentLang);
---

<!-- NAVBAR CONTAINER -->
<!-- Mobile: Bottom Floating Dock Bar | Desktop: Top Floating Glass Navbar -->
<div class="fixed w-full bottom-3 sm:bottom-4 md:bottom-auto md:top-6 left-0 z-50 flex justify-center px-2 sm:px-4 pointer-events-none pb-[env(safe-area-inset-bottom,0)]">
  <nav
    class="pointer-events-auto w-auto max-w-[calc(100vw-1rem)] md:w-fit bg-white/95 backdrop-blur-xl md:backdrop-blur-md rounded-full border border-slate-200/90 shadow-[0_8px_30px_rgb(0,0,0,0.12)] md:shadow-lg transition-all duration-300 px-1.5 sm:px-2.5 md:px-4 py-1 sm:py-1.5 md:py-2"
    id="navbar"
  >
    <div class="flex items-center gap-1 sm:gap-1.5 md:gap-2.5">
      <!-- Logo (Visible on Mobile & Desktop) -->
      <div class="flex items-center justify-center cursor-pointer group h-8 sm:h-9 px-1 shrink-0" id="logo-btn" title="Aldi Kurniawan">
        <Image src={logoPorto} alt="Logo" class="h-5 sm:h-6 w-auto object-contain" />
      </div>

      <!-- Left Divider -->
      <div class="block h-4 sm:h-5 w-[1px] bg-slate-200/90 shrink-0"></div>

      <!-- Navigation Links -->
      <div class="flex items-center gap-0.5 sm:gap-1 md:gap-2" id="nav-links-container">
        <a href="#home" class="nav-link h-8 sm:h-9 w-8 sm:w-9 md:w-auto px-0 md:px-3 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200" title={t.navbar.home}>
          <i data-lucide="home" class="w-4 h-4 shrink-0"></i>
          <span class="nav-label text-[11px] sm:text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.home}</span>
        </a>
        <a href="#about" class="nav-link hidden md:flex h-8 sm:h-9 w-auto px-3 items-center justify-center text-slate-600 rounded-full transition-all duration-200" title={t.navbar.about}>
          <i data-lucide="user" class="w-4 h-4 shrink-0"></i>
          <span class="nav-label text-[11px] sm:text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.about}</span>
        </a>
        <a href="#experience" class="nav-link h-8 sm:h-9 w-8 sm:w-9 md:w-auto px-0 md:px-3 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200" title={t.navbar.experience}>
          <i data-lucide="briefcase" class="w-4 h-4 shrink-0"></i>
          <span class="nav-label text-[11px] sm:text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.experience}</span>
        </a>
        <a href="#portfolio" class="nav-link h-8 sm:h-9 w-8 sm:w-9 md:w-auto px-0 md:px-3 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200" title={t.navbar.portfolio}>
          <i data-lucide="folder" class="w-4 h-4 shrink-0"></i>
          <span class="nav-label text-[11px] sm:text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.portfolio}</span>
        </a>
        <a href="#contact" class="nav-link h-8 sm:h-9 w-8 sm:w-9 md:w-auto px-0 md:px-3 flex items-center justify-center text-slate-600 rounded-full transition-all duration-200" title={t.navbar.contact}>
          <i data-lucide="mail" class="w-4 h-4 shrink-0"></i>
          <span class="nav-label text-[11px] sm:text-xs md:text-sm font-bold ml-1.5 whitespace-nowrap">{t.navbar.contact}</span>
        </a>
      </div>

      <!-- Right Divider -->
      <div class="block h-4 sm:h-5 w-[1px] bg-slate-200/90 shrink-0"></div>

      <!-- Language Switcher Pill Button -->
      <a
        href={currentLang === 'id' ? '/en/' : '/'}
        class="btn-3d-light h-8 sm:h-9 !px-2 sm:!px-2.5 md:!px-3 !text-[11px] sm:!text-xs !font-bold transition-all duration-200 group shrink-0"
        title={currentLang === 'id' ? 'Switch to English' : 'Ganti ke Bahasa Indonesia'}
      >
        <i data-lucide="globe" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-blue-600 group-hover:rotate-12 transition-transform duration-300"></i>
        <span class="font-extrabold tracking-wide uppercase">{currentLang === 'id' ? 'ID' : 'EN'}</span>
      </a>
    </div>
  </nav>
</div>

<script>
  function initNavbarScrollSpy() {
    const navbar = document.getElementById("navbar");
    const logoBtn = document.getElementById("logo-btn");

    // Logo scroll to top
    logoBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const sections = document.querySelectorAll("section");
    const navLinks = document.querySelectorAll(".nav-link");

    function onScroll() {
      if (window.scrollY > 20) {
        navbar?.classList.add("shadow-md");
        navbar?.classList.remove("shadow-lg");
      } else {
        navbar?.classList.add("shadow-lg");
        navbar?.classList.remove("shadow-md");
      }

      const isMobile = window.innerWidth < 768;
      // On mobile bottom navbar, 'about' is hidden, so only track visible dock sections
      const validNavIds = isMobile
        ? ["home", "experience", "portfolio", "contact"]
        : ["home", "about", "experience", "portfolio", "contact"];

      let current = "";
      sections.forEach((section) => {
        const id = section.getAttribute("id") || "";
        if (validNavIds.includes(id)) {
          const sectionTop = section.offsetTop;
          if (window.scrollY >= sectionTop - 160) {
            current = id;
          }
        }
      });

      if (!current || window.scrollY < 100) current = "home";

      navLinks.forEach((link) => {
        const targetSection = link.getAttribute("href");
        if (targetSection === "#" + current) {
          link.classList.add("active");
        } else {
          link.classList.remove("active");
        }
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();
  }

  initNavbarScrollSpy();
  document.addEventListener("DOMContentLoaded", initNavbarScrollSpy);
  window.addEventListener("load", initNavbarScrollSpy);
  document.addEventListener("astro:page-load", initNavbarScrollSpy);
</script>

<style is:global>
  /* Inactive nav links */
  .nav-link {
    color: #475569;
    flex-shrink: 0;
  }
  .nav-link:hover:not(.active) {
    background-color: rgba(241, 245, 249, 0.9);
    color: #0f172a;
  }

  /* On mobile: Hide text label by default on inactive links */
  .nav-link .nav-label {
    display: none;
  }

  /* On desktop: Show text label on all links */
  @media (min-width: 768px) {
    .nav-link .nav-label {
      display: inline;
    }
  }

  /* Active nav link (Mobile & Desktop): Display BOTH icon AND menu name with 3D convex rounded style */
  .nav-link.active {
    width: auto !important;
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
    background: linear-gradient(180deg, #4d8df7 0%, #2b6cef 45%, #1d4ed8 100%) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    box-shadow: 
      inset 0 2px 2px 0 rgba(255, 255, 255, 0.65),
      inset 0 -2px 3px 0 rgba(10, 30, 95, 0.4),
      0 4px 14px -2px rgba(37, 99, 235, 0.45) !important;
    text-shadow: 0 1px 2px rgba(10, 35, 90, 0.3);
  }

  @media (min-width: 640px) {
    .nav-link.active {
      padding-left: 0.875rem !important;
      padding-right: 0.875rem !important;
    }
  }

  /* Force display label when active, even on mobile screen */
  .nav-link.active .nav-label {
    display: inline !important;
  }

  .nav-link.active i,
  .nav-link.active svg,
  .nav-link.active span {
    color: #ffffff !important;
    stroke: #ffffff !important;
  }
</style>

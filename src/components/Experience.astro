---
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);

const meta = [
  {
    typeColor: "bg-primary/10 text-primary border-primary/20",
    icon: "building-2",
    tags: ["HTML5", "CSS3", "JavaScript", "Tailwind CSS"],
  },
  {
    typeColor: "bg-emerald-500/10 text-emerald-600 border-emerald-500/20",
    icon: "building-2",
    tags: ["Web Admin", "MySQL", "Troubleshooting"],
  },
  {
    typeColor: "bg-amber-500/10 text-amber-600 border-amber-500/20",
    icon: "user",
    tags: ["Responsive Web", "UI/UX Design", "HTML & CSS"],
  },
];

const experiences = t.experience.items.map((item, index) => ({
  ...item,
  ...meta[index],
}));
---

<!-- 4. WORK EXPERIENCE SECTION -->
<section id="experience" class="py-24 bg-slate-50 relative overflow-hidden text-slate-600">
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-30 -z-10"></div>
  <div class="absolute top-1/3 left-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-1/3 right-1/4 w-[500px] h-[500px] bg-purple-500/5 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-4xl mx-auto px-6 w-full">
    <!-- Section Header -->
    <div class="text-center mb-20" data-aos="fade-up">
      <h2 class="text-sm font-bold text-primary uppercase tracking-widest mb-2">{t.experience.title}</h2>
      <h3 class="text-3xl md:text-4xl font-bold text-secondary">{t.experience.subtitle}</h3>
      <p class="text-slate-500 mt-4 max-w-lg mx-auto">{t.experience.description}</p>
    </div>

    <!-- Timeline Container -->
    <div class="relative ml-4 md:ml-6 pl-8 md:pl-12 space-y-12" id="timeline-container">
      <!-- Static Timeline Line (Background) -->
      <div class="absolute left-0 top-0 bottom-0 w-[2px] bg-slate-200"></div>
      <!-- Animated Timeline Line (Fills on scroll) -->
      <div id="timeline-progress" class="absolute left-0 top-0 w-[2px] bg-gradient-to-b from-blue-500 via-indigo-500 to-violet-500 will-change-[height]" style="height: 0px;"></div>
      <!-- Glowing tip at the bottom of the progress line -->
      <div id="timeline-glow" class="absolute left-[-3px] w-[8px] h-[8px] rounded-full bg-blue-500 shadow-[0_0_12px_4px_rgba(59,130,246,0.6)] will-change-[top,opacity] opacity-0" style="top: 0px;"></div>
      
      {experiences.map((exp, index) => (
        <div class="relative group timeline-item" data-aos="fade-up" data-aos-delay={index * 100}>
          <!-- Timeline Dot -->
          <div class="timeline-dot absolute -left-[41px] md:-left-[57px] top-4 w-6 h-6 rounded-full border-4 flex items-center justify-center transition-all duration-700">
            <div class="timeline-dot-inner w-1.5 h-1.5 rounded-full transition-colors duration-700"></div>
          </div>

          <!-- Dual-Layer Master Card with Silky Cross-Fade -->
          <div class="experience-card-3d relative rounded-3xl overflow-hidden select-none">
            
            <!-- ================= LAYER 1: LIGHT 3D CONVEX STATE ================= -->
            <div class="exp-layer-light relative z-0 p-6 md:p-8 transition-opacity duration-700">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">
                <div>
                  <span class="inline-flex items-center gap-1.5 text-xs font-extrabold px-3.5 py-1 rounded-full mb-2.5 uppercase tracking-wider bg-gradient-to-b from-white to-blue-50 border border-blue-200 text-blue-600 shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),0_2px_4px_rgba(37,99,235,0.06)]">
                    {exp.type}
                  </span>
                  <h4 class="text-xl md:text-2xl font-extrabold tracking-tight text-slate-900">{exp.title}</h4>
                </div>
                <span class="text-xs font-extrabold md:text-right px-3.5 py-1.5 rounded-full w-fit bg-slate-100 border border-slate-200 text-slate-500">
                  {exp.period}
                </span>
              </div>

              <!-- Company Row -->
              <div class="flex items-center gap-3 text-sm font-bold mb-4 text-slate-700">
                <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 bg-gradient-to-b from-white to-blue-50 border border-blue-200 text-blue-600 shadow-sm">
                  <i data-lucide={exp.icon} class="w-4 h-4"></i>
                </div>
                <span>{exp.company}</span>
              </div>

              <!-- Description -->
              <p class="text-sm md:text-[14.5px] leading-relaxed mb-6 font-medium text-slate-600">{exp.description}</p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {exp.tags.map((tag) => (
                  <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-600 cursor-default">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- ================= LAYER 2: BLUE 3D CONVEX STATE (Cross-Fade Overlay) ================= -->
            <div class="exp-layer-blue absolute inset-0 z-10 p-6 md:p-8 opacity-0 pointer-events-none transition-opacity duration-700">
              <!-- Internal Ambient Glows -->
              <div class="absolute -top-20 -right-20 w-52 h-52 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
              <div class="absolute -bottom-20 -left-20 w-52 h-52 bg-indigo-500/25 rounded-full blur-2xl pointer-events-none"></div>

              <div class="relative z-10">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">
                  <div>
                    <span class="inline-flex items-center gap-1.5 text-xs font-extrabold px-3.5 py-1 rounded-full mb-2.5 uppercase tracking-wider bg-white/20 border border-white/35 text-white shadow-[inset_0_1.5px_2px_rgba(255,255,255,0.7),0_2px_6px_rgba(0,0,0,0.15)]">
                      {exp.type}
                    </span>
                    <h4 class="text-xl md:text-2xl font-extrabold tracking-tight text-white">{exp.title}</h4>
                  </div>
                  <span class="text-xs font-extrabold md:text-right px-3.5 py-1.5 rounded-full w-fit bg-white/15 border border-white/25 text-blue-100">
                    {exp.period}
                  </span>
                </div>

                <!-- Company Row -->
                <div class="flex items-center gap-3 text-sm font-bold mb-4 text-white">
                  <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 bg-gradient-to-b from-white/35 to-white/15 border border-white/40 text-white shadow-sm">
                    <i data-lucide={exp.icon} class="w-4 h-4"></i>
                  </div>
                  <span>{exp.company}</span>
                </div>

                <!-- Description -->
                <p class="text-sm md:text-[14.5px] leading-relaxed mb-6 font-medium text-blue-50/90">{exp.description}</p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2">
                  {exp.tags.map((tag) => (
                    <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-white/15 border border-white/25 text-white cursor-default">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* Experience 3D Master Card Container */
  .experience-card-3d {
    background: linear-gradient(180deg, #ffffff 0%, #fcfdfd 45%, #f8fafc 100%);
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-top: 1.5px solid rgba(255, 255, 255, 1);
    box-shadow: 
      inset 0 2.5px 3px 0 rgba(255, 255, 255, 1),
      inset 0 -2.5px 4px 0 rgba(0, 0, 0, 0.03),
      0 12px 30px -8px rgba(15, 23, 42, 0.07),
      0 4px 10px -2px rgba(15, 23, 42, 0.03);
    transition: 
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, box-shadow;
  }

  /* Blue Layer Styling */
  .exp-layer-blue {
    background: linear-gradient(170deg, #3b82f6 0%, #2563eb 28%, #1d4ed8 65%, #172554 100%);
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 0.7),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -4px 8px 0 rgba(10, 25, 75, 0.6);
    will-change: opacity;
  }

  /* Active State Trigger */
  .timeline-item.active .experience-card-3d {
    border-color: rgba(255, 255, 255, 0.5) !important;
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 0.7),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -4px 8px 0 rgba(10, 25, 75, 0.6),
      0 22px 45px -8px rgba(37, 99, 235, 0.45),
      0 8px 16px -4px rgba(15, 23, 42, 0.25) !important;
    transform: translateY(-4px) scale(1.01);
  }

  .timeline-item.active .exp-layer-blue {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .timeline-item.active .exp-layer-light {
    opacity: 0 !important;
  }

  /* Timeline Dot Transitions */
  .timeline-dot {
    background-color: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }
  .timeline-dot-inner {
    background-color: #94a3b8;
  }

  .timeline-item.active .timeline-dot {
    background-color: #2563eb !important;
    border-color: #ffffff !important;
    box-shadow: 0 0 18px rgba(59, 130, 246, 0.7), 0 0 0 3px rgba(59, 130, 246, 0.35) !important;
  }
  .timeline-item.active .timeline-dot-inner {
    background-color: #ffffff !important;
  }

  #timeline-glow {
    animation: glow-pulse 2s ease-in-out infinite;
  }
  @keyframes glow-pulse {
    0%, 100% { box-shadow: 0 0 12px 4px rgba(59, 130, 246, 0.5); }
    50% { box-shadow: 0 0 20px 6px rgba(99, 102, 241, 0.75); }
  }
</style>

<script>
  function initTimelineScroll() {
    const container = document.getElementById("timeline-container");
    const progressLine = document.getElementById("timeline-progress");
    const glowDot = document.getElementById("timeline-glow");

    if (!container || !progressLine || !glowDot) return;

    const items = container.querySelectorAll<HTMLElement>(".timeline-item");
    let currentHeight = 0;
    let targetHeight = 0;
    let currentOpacity = 0;
    let targetOpacity = 0;
    let rafId: number | null = null;

    // Smooth Lerp Helper
    function lerp(start: number, end: number, factor: number): number {
      return start + (end - start) * factor;
    }

    function calculateTarget() {
      const rect = container!.getBoundingClientRect();
      const containerHeight = container!.offsetHeight;
      const windowHeight = window.innerHeight;

      // Trigger point when 65% of viewport has scrolled
      const startOffset = windowHeight * 0.65;
      const scrolled = startOffset - rect.top;
      const progress = Math.min(Math.max(scrolled / containerHeight, 0), 1);

      targetHeight = progress * containerHeight;

      if (progress > 0.01 && progress < 0.99) {
        targetOpacity = 1;
      } else {
        targetOpacity = 0;
      }
    }

    function animate() {
      // Silky smooth interpolation
      currentHeight = lerp(currentHeight, targetHeight, 0.07);
      currentOpacity = lerp(currentOpacity, targetOpacity, 0.08);

      // Apply line height & glow position directly (GPU accelerated)
      progressLine!.style.height = currentHeight + "px";
      glowDot!.style.top = currentHeight + "px";
      glowDot!.style.opacity = String(currentOpacity);

      // Smoothly activate each card when the line reaches its dot
      items.forEach((item) => {
        const itemTop = item.offsetTop + 16;
        if (currentHeight >= itemTop) {
          item.classList.add("active");
        } else {
          item.classList.remove("active");
        }
      });

      rafId = requestAnimationFrame(animate);
    }

    window.addEventListener("scroll", calculateTarget, { passive: true });
    window.addEventListener("resize", calculateTarget, { passive: true });

    calculateTarget();
    currentHeight = targetHeight;
    currentOpacity = targetOpacity;
    rafId = requestAnimationFrame(animate);
  }

  initTimelineScroll();
  document.addEventListener("astro:page-load", () => {
    initTimelineScroll();
  });
</script>

---
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);

const meta = [
  {
    typeColor: "bg-primary/10 text-primary border-primary/20",
    icon: "building-2",
    tags: ["HTML5", "CSS3", "JavaScript", "Tailwind CSS"],
  },
  {
    typeColor: "bg-emerald-500/10 text-emerald-600 border-emerald-500/20",
    icon: "building-2",
    tags: ["Web Admin", "MySQL", "Troubleshooting"],
  },
  {
    typeColor: "bg-amber-500/10 text-amber-600 border-amber-500/20",
    icon: "user",
    tags: ["Responsive Web", "UI/UX Design", "HTML & CSS"],
  },
];

const experiences = t.experience.items.map((item, index) => ({
  ...item,
  ...meta[index],
}));
---

<!-- 4. WORK EXPERIENCE SECTION -->
<section id="experience" class="py-24 bg-slate-50 relative overflow-hidden text-slate-600">
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-30 -z-10"></div>
  <div class="absolute top-1/3 left-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-1/3 right-1/4 w-[500px] h-[500px] bg-purple-500/5 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-4xl mx-auto px-6 w-full">
    <!-- Section Header -->
    <div class="text-center mb-20" data-aos="fade-up">
      <h2 class="text-sm font-bold text-primary uppercase tracking-widest mb-2">{t.experience.title}</h2>
      <h3 class="text-3xl md:text-4xl font-bold text-secondary">{t.experience.subtitle}</h3>
      <p class="text-slate-500 mt-4 max-w-lg mx-auto">{t.experience.description}</p>
    </div>

    <!-- Timeline Container -->
    <div class="relative ml-4 md:ml-6 pl-8 md:pl-12 space-y-12" id="timeline-container">
      <!-- Static Timeline Line (Background) -->
      <div class="absolute left-0 top-0 bottom-0 w-[2px] bg-slate-200"></div>
      <!-- Animated Timeline Line (Fills on scroll) -->
      <div id="timeline-progress" class="absolute left-0 top-0 w-[2px] bg-gradient-to-b from-blue-500 via-indigo-500 to-violet-500" style="height: 0px;"></div>
      <!-- Glowing tip at the bottom of the progress line -->
      <div id="timeline-glow" class="absolute left-[-3px] w-[8px] h-[8px] rounded-full bg-blue-500 shadow-[0_0_12px_4px_rgba(59,130,246,0.5)] opacity-0" style="top: 0px;"></div>
      {experiences.map((exp, index) => (
        <div class="relative group timeline-item" data-aos="fade-up" data-aos-delay={index * 100}>
          <!-- Timeline Dot -->
          <div class="timeline-dot absolute -left-[41px] md:-left-[57px] top-2 w-6 h-6 rounded-full border-4 flex items-center justify-center">
            <div class="timeline-dot-inner w-1.5 h-1.5 rounded-full"></div>
          </div>

          <!-- Content Card with Dynamic 3D Convex Transition -->
          <div class="experience-card-3d rounded-3xl p-6 md:p-8 relative overflow-hidden group/card">
            <!-- Layer 1: White 3D Convex Base Layer -->
            <div class="exp-bg-white absolute inset-0 pointer-events-none"></div>

            <!-- Layer 2: Blue 3D Convex "Get In Touch" Gradient Layer -->
            <div class="exp-bg-blue absolute inset-0 pointer-events-none"></div>

            <!-- Ambient glows inside card (visible in active blue state) -->
            <div class="exp-glow-1 absolute -top-20 -right-20 w-52 h-52 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
            <div class="exp-glow-2 absolute -bottom-20 -left-20 w-52 h-52 bg-indigo-500/20 rounded-full blur-2xl pointer-events-none"></div>

            <div class="relative z-10">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">
                <div>
                  <span class="exp-type-badge inline-flex items-center gap-1.5 text-xs font-extrabold px-3.5 py-1 rounded-full mb-2.5 uppercase tracking-wider">
                    {exp.type}
                  </span>
                  <h4 class="exp-title text-xl md:text-2xl font-extrabold tracking-tight">{exp.title}</h4>
                </div>
                <span class="exp-period-badge text-xs font-extrabold md:text-right px-3.5 py-1.5 rounded-full w-fit">
                  {exp.period}
                </span>
              </div>

              <!-- Company Row with 3D Convex Icon -->
              <div class="flex items-center gap-3 text-sm font-bold mb-4">
                <div class="exp-icon-box w-8 h-8 rounded-xl flex items-center justify-center shrink-0">
                  <i data-lucide={exp.icon} class="w-4 h-4"></i>
                </div>
                <span class="exp-company-text">{exp.company}</span>
              </div>

              <!-- Description -->
              <p class="exp-desc text-sm md:text-[14.5px] leading-relaxed mb-6 font-medium">{exp.description}</p>

              <!-- Tags with 3D Convex Glass Look -->
              <div class="flex flex-wrap gap-2">
                {exp.tags.map((tag) => (
                  <span class="exp-tag text-xs font-bold px-3 py-1.5 rounded-xl cursor-default">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* Experience 3D Card Shell */
  .experience-card-3d {
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.95);
    box-shadow: 
      inset 0 2.5px 3px 0 rgba(255, 255, 255, 1),
      inset 0 -2.5px 4px 0 rgba(0, 0, 0, 0.03),
      0 12px 30px -8px rgba(15, 23, 42, 0.07),
      0 4px 10px -2px rgba(15, 23, 42, 0.03);
    transition: 
      border-color 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Layer 1: White 3D Convex Base */
  .experience-card-3d .exp-bg-white {
    background: linear-gradient(180deg, #ffffff 0%, #fcfdfd 45%, #f8fafc 100%);
    opacity: 1;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Layer 2: Blue 3D Convex Overlay */
  .experience-card-3d .exp-bg-blue {
    background: linear-gradient(170deg, #3b82f6 0%, #2563eb 28%, #1d4ed8 65%, #172554 100%);
    opacity: 0;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Typography Transitions */
  .experience-card-3d .exp-title {
    color: #0f172a;
    transition: color 0.5s ease;
  }
  .experience-card-3d .exp-desc {
    color: #475569;
    transition: color 0.5s ease;
  }
  .experience-card-3d .exp-company-text {
    color: #334155;
    transition: color 0.5s ease;
  }

  /* Default Type Badge */
  .experience-card-3d .exp-type-badge {
    background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
    border: 1px solid rgba(191, 219, 254, 0.9);
    color: #2563eb;
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 2px 0 rgba(37, 99, 235, 0.1),
      0 2px 5px rgba(37, 99, 235, 0.08);
    transition: all 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default Period Badge */
  .experience-card-3d .exp-period-badge {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #64748b;
    box-shadow: inset 0 1px 2px 0 rgba(0, 0, 0, 0.02);
    transition: all 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default Icon Box */
  .experience-card-3d .exp-icon-box {
    background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
    border: 1px solid rgba(191, 219, 254, 0.95);
    color: #2563eb;
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 1),
      inset 0 -1.5px 2px 0 rgba(37, 99, 235, 0.12),
      0 3px 6px rgba(0, 0, 0, 0.04);
    transition: all 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default Tags */
  .experience-card-3d .exp-tag {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #475569;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .experience-card-3d .exp-tag:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  /* Default Ambient Glows */
  .experience-card-3d .exp-glow-1,
  .experience-card-3d .exp-glow-2 {
    opacity: 0;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default Timeline Dot */
  .timeline-dot {
    background-color: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .timeline-dot-inner {
    background-color: #94a3b8;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* =========================================================
     ACTIVE STATE: Ultra-Smooth Cross-fade to Blue 3D Convex
     ========================================================= */
  .timeline-item.active .experience-card-3d {
    border-color: rgba(255, 255, 255, 0.45) !important;
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 0.7),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -4px 8px 0 rgba(10, 25, 75, 0.6),
      0 22px 45px -8px rgba(37, 99, 235, 0.45),
      0 8px 16px -4px rgba(15, 23, 42, 0.25) !important;
    transform: translateY(-4px) scale(1.01);
  }

  .timeline-item.active .experience-card-3d .exp-bg-white {
    opacity: 0 !important;
  }
  .timeline-item.active .experience-card-3d .exp-bg-blue {
    opacity: 1 !important;
  }

  /* Active Typography */
  .timeline-item.active .experience-card-3d .exp-title {
    color: #ffffff !important;
  }
  .timeline-item.active .experience-card-3d .exp-desc {
    color: rgba(239, 246, 255, 0.92) !important;
  }
  .timeline-item.active .experience-card-3d .exp-company-text {
    color: rgba(255, 255, 255, 0.95) !important;
  }

  /* Active Type Badge */
  .timeline-item.active .experience-card-3d .exp-type-badge {
    background: rgba(255, 255, 255, 0.22) !important;
    border-color: rgba(255, 255, 255, 0.35) !important;
    color: #ffffff !important;
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.75),
      inset 0 -1.5px 2px 0 rgba(10, 25, 75, 0.35),
      0 3px 8px rgba(0, 0, 0, 0.15) !important;
  }

  /* Active Period Badge */
  .timeline-item.active .experience-card-3d .exp-period-badge {
    background: rgba(255, 255, 255, 0.18) !important;
    border-color: rgba(255, 255, 255, 0.3) !important;
    color: #dbeafe !important;
    box-shadow: inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.5) !important;
  }

  /* Active Icon Box */
  .timeline-item.active .experience-card-3d .exp-icon-box {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.15) 100%) !important;
    border-color: rgba(255, 255, 255, 0.45) !important;
    color: #ffffff !important;
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.8),
      inset 0 -1.5px 2px 0 rgba(10, 25, 75, 0.3),
      0 4px 10px rgba(0, 0, 0, 0.15) !important;
  }

  /* Active Tags */
  .timeline-item.active .experience-card-3d .exp-tag {
    background: rgba(255, 255, 255, 0.16) !important;
    border-color: rgba(255, 255, 255, 0.28) !important;
    color: #ffffff !important;
    box-shadow: inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.4), 0 2px 6px rgba(0, 0, 0, 0.12) !important;
  }
  .timeline-item.active .experience-card-3d .exp-tag:hover {
    background: rgba(255, 255, 255, 0.28) !important;
  }

  /* Active Glows */
  .timeline-item.active .experience-card-3d .exp-glow-1,
  .timeline-item.active .experience-card-3d .exp-glow-2 {
    opacity: 1 !important;
  }

  /* Active Timeline Dot */
  .timeline-item.active .timeline-dot {
    background-color: #2563eb !important;
    border-color: #ffffff !important;
    box-shadow: 0 0 16px rgba(59, 130, 246, 0.65), 0 0 0 3px rgba(59, 130, 246, 0.35) !important;
  }
  .timeline-item.active .timeline-dot-inner {
    background-color: #ffffff !important;
  }

  /* Timeline progress line glow pulse */
  #timeline-glow {
    animation: glow-pulse 2s ease-in-out infinite;
  }
  @keyframes glow-pulse {
    0%, 100% { box-shadow: 0 0 12px 4px rgba(59, 130, 246, 0.5); }
    50% { box-shadow: 0 0 20px 6px rgba(99, 102, 241, 0.7); }
  }
</style>

<script>
  function initTimelineScroll() {
    const container = document.getElementById("timeline-container");
    const progressLine = document.getElementById("timeline-progress");
    const glowDot = document.getElementById("timeline-glow");

    if (!container || !progressLine || !glowDot) return;

    const items = container.querySelectorAll<HTMLElement>(".timeline-item");
    let currentHeight = 0;
    let targetHeight = 0;
    let currentOpacity = 0;
    let targetOpacity = 0;
    let rafId: number | null = null;

    // Lerp helper for silky smooth interpolation
    function lerp(start: number, end: number, factor: number): number {
      return start + (end - start) * factor;
    }

    function calculateTarget() {
      const rect = container!.getBoundingClientRect();
      const containerHeight = container!.offsetHeight;
      const windowHeight = window.innerHeight;

      const startOffset = windowHeight * 0.65;
      const scrolled = startOffset - rect.top;
      const progress = Math.min(Math.max(scrolled / containerHeight, 0), 1);

      targetHeight = progress * containerHeight;

      if (progress > 0.01 && progress < 0.99) {
        targetOpacity = 1;
      } else {
        targetOpacity = 0;
      }
    }

    function animate() {
      // Smooth lerp follow factor
      currentHeight = lerp(currentHeight, targetHeight, 0.08);
      currentOpacity = lerp(currentOpacity, targetOpacity, 0.1);

      // Apply styles directly (GPU accelerated)
      progressLine!.style.height = currentHeight + "px";
      glowDot!.style.top = currentHeight + "px";
      glowDot!.style.opacity = String(currentOpacity);

      // Dynamically activate card with smooth transition
      items.forEach((item) => {
        const itemTop = item.offsetTop + 10;
        if (currentHeight >= itemTop) {
          item.classList.add("active");
        } else {
          item.classList.remove("active");
        }
      });

      // Keep the loop running
      rafId = requestAnimationFrame(animate);
    }

    // Listen to scroll for target updates only
    window.addEventListener("scroll", calculateTarget, { passive: true });
    window.addEventListener("resize", calculateTarget, { passive: true });

    // Initial calculation and start animation loop
    calculateTarget();
    currentHeight = targetHeight; // snap to initial position
    currentOpacity = targetOpacity;
    rafId = requestAnimationFrame(animate);
  }

  // Initialize on load & Astro page transitions
  initTimelineScroll();
  document.addEventListener("astro:page-load", () => {
    initTimelineScroll();
  });
</script>

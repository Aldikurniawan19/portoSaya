---
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);

const row1Skills = [
  { name: "PostgreSQL", icon: "postgresql/336791", color: "#336791" },
  { name: "Figma", icon: "figma/F24E1E", color: "#F24E1E" },
  { name: "Laravel", icon: "laravel/FF2D20", color: "#FF2D20" },
  { name: "Next.js", icon: "nextdotjs/000000", color: "#000000" },
  { name: "React", icon: "react/0284c7", color: "#0284c7" },
  { name: "Tailwind CSS", icon: "tailwindcss/06B6D4", color: "#0ea5e9" },
  { name: "TypeScript", icon: "typescript/3178C6", color: "#3178C6" },
];

const row2Skills = [
  { name: "JavaScript", icon: "javascript/F7DF1E", color: "#d97706" },
  { name: "PHP", icon: "php/777BB4", color: "#777BB4" },
  { name: "MySQL", icon: "mysql/4479A1", color: "#4479A1" },
  { name: "Node.js", icon: "nodedotjs/339933", color: "#16a34a" },
  { name: "Python", icon: "python/3776AB", color: "#3776AB" },
  { name: "Git", icon: "git/F05032", color: "#F05032" },
  { name: "Bootstrap", icon: "bootstrap/7952B3", color: "#7952B3" },
];
---

<!-- 3. TECH SKILLS SECTION -->
<section id="skills" class="py-24 bg-transparent relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 w-full mb-12">
    <div class="text-center" data-aos="zoom-in" data-aos-duration="750" data-aos-easing="ease-out-cubic">
      <h2 class="text-xs sm:text-sm font-extrabold text-slate-400 uppercase tracking-[0.2em] mb-2">
        {t.skills.title}
      </h2>
      <h3 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight py-2 leading-snug">
        <span class="heading-timbul-blue">{t.skills.subtitle}</span>
      </h3>
      <p class="text-slate-500 mt-4 max-w-lg mx-auto">
        {t.skills.description}
      </p>
    </div>
  </div>

  <!-- Slider Marquee Container with Balanced Spaced Skill Components -->
  <div class="w-full flex flex-col gap-6 py-2" data-aos="zoom-in" data-aos-delay="150" data-aos-duration="750" data-aos-easing="ease-out-cubic">
    <!-- Row 1: Left -->
    <div class="marquee-wrapper py-2">
      <div class="marquee-track animate-scroll-left">
        {
          [0, 1].map(() => (
            <div class="marquee-group">
              {row1Skills.map((skill) => (
                <div class="group flex items-center gap-3 shrink-0 cursor-default select-none transition-transform duration-300 hover:scale-105">
                  <img
                    src={`https://cdn.simpleicons.org/${skill.icon}`}
                    class="w-7 h-7 sm:w-8 sm:h-8 object-contain filter drop-shadow-sm transition-transform duration-300 group-hover:scale-110"
                    alt={skill.name}
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                  />
                  <span
                    class="font-bold text-base sm:text-lg tracking-tight transition-opacity duration-200"
                    style={`color: ${skill.color};`}
                  >
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Row 2: Right -->
    <div class="marquee-wrapper py-2">
      <div class="marquee-track animate-scroll-right">
        {
          [0, 1].map(() => (
            <div class="marquee-group">
              {row2Skills.map((skill) => (
                <div class="group flex items-center gap-3 shrink-0 cursor-default select-none transition-transform duration-300 hover:scale-105">
                  <img
                    src={`https://cdn.simpleicons.org/${skill.icon}`}
                    class="w-7 h-7 sm:w-8 sm:h-8 object-contain filter drop-shadow-sm transition-transform duration-300 group-hover:scale-110"
                    alt={skill.name}
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                  />
                  <span
                    class="font-bold text-base sm:text-lg tracking-tight transition-opacity duration-200"
                    style={`color: ${skill.color};`}
                  >
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>


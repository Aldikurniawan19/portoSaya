---
interface Props {
  beams?: boolean;
  glows?: boolean;
  gridOpacity?: string;
  parallaxSpeed?: number;
  class?: string;
}

const {
  beams = true,
  glows = true,
  gridOpacity = "opacity-100",
  parallaxSpeed = -0.28,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "section-bg-container absolute inset-0 -z-10 overflow-hidden pointer-events-none contain-paint",
    className,
  ]}
>
  <!-- Background Grid & Beams Parallax Layer -->
  <div
    class="parallax-layer absolute inset-0 -top-48 -bottom-48 will-change-transform pointer-events-none"
    data-parallax-speed={parallaxSpeed}
  >
    <div class:list={["absolute inset-0 bg-grid-pattern bg-grid", gridOpacity]}>
      {beams && (
        <>
          <!-- Horizontal Beams (GPU Accelerated) -->
          <div
            class="absolute h-[2.5px] w-[180px] bg-gradient-to-r from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="top: 15%; animation: beam-h 7.5s linear infinite; animation-delay: 0s;"
          />
          <div
            class="hidden sm:block absolute h-[2.5px] w-[180px] bg-gradient-to-l from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="top: 38%; animation: beam-h-reverse 9s linear infinite; animation-delay: 2.2s;"
          />
          <div
            class="hidden sm:block absolute h-[2.5px] w-[180px] bg-gradient-to-r from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="top: 65%; animation: beam-h 8.5s linear infinite; animation-delay: 4.5s;"
          />
          <div
            class="hidden md:block absolute h-[2.5px] w-[180px] bg-gradient-to-l from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="top: 85%; animation: beam-h-reverse 10.5s linear infinite; animation-delay: 1.5s;"
          />

          <!-- Vertical Beams (GPU Accelerated) -->
          <div
            class="absolute w-[2.5px] h-[180px] bg-gradient-to-b from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="left: 12%; animation: beam-v 8.5s linear infinite; animation-delay: 1s;"
          />
          <div
            class="hidden sm:block absolute w-[2.5px] h-[180px] bg-gradient-to-t from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="left: 32%; animation: beam-v-reverse 10s linear infinite; animation-delay: 3.5s;"
          />
          <div
            class="hidden md:block absolute w-[2.5px] h-[180px] bg-gradient-to-b from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="left: 54%; animation: beam-v 9.5s linear infinite; animation-delay: 5s;"
          />
          <div
            class="hidden md:block absolute w-[2.5px] h-[180px] bg-gradient-to-t from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="left: 76%; animation: beam-v-reverse 11s linear infinite; animation-delay: 2s;"
          />
          <div
            class="hidden lg:block absolute w-[2.5px] h-[180px] bg-gradient-to-b from-transparent via-blue-500/80 to-transparent will-change-transform pointer-events-none"
            style="left: 92%; animation: beam-v 8.5s linear infinite; animation-delay: 4.2s;"
          />
        </>
      )}
    </div>
  </div>

  <!-- Deep Floating Glow Orbs with Independent High-Speed Parallax -->
  {glows && (
    <>
      <div
        class="parallax-layer absolute top-4 left-[-8%] w-[520px] h-[520px] bg-blue-500/10 rounded-full blur-[140px] pointer-events-none will-change-transform"
        data-parallax-speed="-0.45"
      />
      <div
        class="parallax-layer absolute bottom-4 right-[-8%] w-[520px] h-[520px] bg-indigo-500/10 rounded-full blur-[150px] pointer-events-none will-change-transform"
        data-parallax-speed="-0.52"
      />
      <div
        class="parallax-layer hidden md:block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[420px] h-[420px] bg-sky-500/5 rounded-full blur-[120px] pointer-events-none will-change-transform"
        data-parallax-speed="-0.38"
      />
    </>
  )}
</div>

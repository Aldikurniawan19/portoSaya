---
import { Image } from 'astro:assets';
import imgHero from '../assets/imgHero.png';
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);
---

<!-- 1. HOME SECTION -->
<section id="home" class="relative min-h-[100dvh] lg:min-h-screen flex items-center pt-14 pb-20 sm:pt-16 lg:pt-20 sm:pb-16 lg:pb-0 overflow-hidden bg-transparent">
  <div class="max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
    <!-- Left Content: Typography Focused -->
    <div class="space-y-4 sm:space-y-6 order-2 lg:order-1 fade-in-up">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-400">{t.hero.hello}</span>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-secondary leading-[1.15] tracking-tight py-1">
        <span class="hero-name-timbul">Aldi</span> <br />
        <span class="inline-block ml-6 sm:ml-8 lg:ml-12"><span class="hero-name-timbul-blue">Kurniawan</span><span class="hero-name-timbul-blue">.</span></span>
      </h1>

      <div class="hero-role-badge-3d px-4 py-1.5 text-xs sm:text-sm font-extrabold text-secondary w-fit tracking-wider uppercase select-none cursor-default">
        {t.hero.role}
      </div>

      <div class="flex items-center gap-4 text-slate-400">
        <a href="https://github.com/Aldikurniawan19" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-black transition-all duration-300 transform hover:scale-110 inline-block">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        </a>
        <a href="https://www.instagram.com/aldii_kurniawannnn?igsh=MWJ4c2I3dmIyM3gwdQ==" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-[#E1306C] transition-all duration-300 transform hover:scale-110 inline-block">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="hover:text-[#0077B5] transition-all duration-300 transform hover:scale-110 inline-block">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      </div>

      <p class="text-sm sm:text-base text-slate-500 max-w-md leading-relaxed">
        {t.hero.description}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4 pt-1 sm:pt-2 w-full max-w-[430px]">
        <a href="#portfolio" class="btn-3d-blue w-full px-5 py-3.5 text-sm sm:text-base font-bold justify-center text-center">
          <i data-lucide="briefcase" class="w-4 h-4 shrink-0"></i>
          <span>{t.hero.viewProjects}</span>
        </a>
        <a href="#contact" class="btn-3d-light w-full px-5 py-3.5 text-sm sm:text-base font-bold justify-center text-center">
          <i data-lucide="mail" class="w-4 h-4 text-blue-600 shrink-0"></i>
          <span>{t.hero.contactMe}</span>
        </a>
      </div>
    </div>

    <!-- Right Content: Hero Image (Desktop Only) with Floating 3D Developer Badges (Mobile & Desktop) -->
    <div class="contents lg:flex lg:order-2 relative justify-center" data-aos="zoom-in" data-aos-duration="600">
      <!-- Background Glow (Desktop only) -->
      <div class="hidden lg:block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-indigo-500/10 rounded-full blur-3xl -z-10"></div>

      <!-- Main Container (Absolute top-right on mobile, flex-centered on desktop) -->
      <div class="absolute top-16 sm:top-20 right-3 sm:right-6 lg:relative lg:top-auto lg:right-auto z-20 w-44 sm:w-52 lg:w-full lg:max-w-[360px] h-36 sm:h-40 lg:h-auto lg:aspect-[4/5] flex lg:items-end lg:justify-center overflow-visible pointer-events-none select-none lg:-translate-y-10">
        <!-- Abstract Oval Background Shape (Blue organic shape - Desktop only) -->
        <div class="hidden lg:block absolute bottom-4 left-1/2 -translate-x-1/2 w-[220px] h-[280px] bg-[#3b82f6] rounded-[60%_40%_30%_70%_/_60%_30%_70%_40%] rotate-[6deg] -z-10 shadow-lg shadow-blue-500/15"></div>

        <!-- ================= FLOATING 3D DEVELOPER BUTTONS (Mobile & Desktop) ================= -->
        
        <!-- 1. 3D Button: </> (Primary 3D Blue - Melayang di Kiri Atas) -->
        <div class="absolute top-0 left-0 lg:-top-7 lg:-left-7 z-30 pointer-events-auto select-none" data-aos="fade-down" data-aos-delay="200">
          <div class="dev-btn-3d dev-btn-3d-blue dev-float-1 px-3 sm:px-4 py-1.5 sm:py-2.5 rounded-xl sm:rounded-2xl flex items-center justify-center font-mono font-black text-xs sm:text-sm tracking-wider cursor-pointer transform hover:scale-115 active:scale-95 transition-all duration-200" title="Code">
            <span class="text-white drop-shadow-[0_1px_2px_rgba(10,35,90,0.6)]">&lt;/&gt;</span>
          </div>
        </div>

        <!-- 2. 3D Button: // (3D Emerald - Melayang di Kanan Atas) -->
        <div class="absolute top-1 right-0 lg:-top-4 lg:-right-5 z-30 pointer-events-auto select-none" data-aos="fade-down" data-aos-delay="300">
          <div class="dev-btn-3d dev-btn-3d-emerald dev-float-4 px-2.5 sm:px-3.5 py-1 sm:py-2 rounded-xl sm:rounded-2xl flex items-center justify-center font-mono font-black text-[11px] sm:text-sm tracking-wide cursor-pointer transform hover:scale-115 active:scale-95 transition-all duration-200" title="Comment">
            <span class="text-emerald-700 drop-shadow-xs">//</span>
          </div>
        </div>

        <!-- 3. 3D Button: >_ (3D Dark Terminal - Melayang di Kiri Tengah) -->
        <div class="absolute top-14 left-1 lg:top-[38%] lg:-left-9 z-30 pointer-events-auto select-none" data-aos="fade-right" data-aos-delay="400">
          <div class="dev-btn-3d dev-btn-3d-dark dev-float-3 px-2.5 sm:px-3.5 py-1 sm:py-2 rounded-xl sm:rounded-2xl flex items-center justify-center font-mono font-black text-[11px] sm:text-xs tracking-wide cursor-pointer transform hover:scale-115 active:scale-95 transition-all duration-200" title="Terminal">
            <span class="text-emerald-400 drop-shadow-[0_0_6px_rgba(52,211,153,0.7)]">&gt;_</span>
          </div>
        </div>

        <!-- 4. 3D Button: { } (3D Light Convex - Melayang di Kanan Tengah) -->
        <div class="absolute top-14 right-1 lg:top-[34%] lg:-right-8 z-30 pointer-events-auto select-none" data-aos="fade-left" data-aos-delay="500">
          <div class="dev-btn-3d dev-btn-3d-light dev-float-2 px-2.5 sm:px-4 py-1 sm:py-2 rounded-xl sm:rounded-2xl flex items-center justify-center font-mono font-black text-xs sm:text-sm tracking-wide cursor-pointer transform hover:scale-115 active:scale-95 transition-all duration-200" title="Brackets">
            <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent font-extrabold">{`{ }`}</span>
          </div>
        </div>

        <!-- 5. 3D Button: git:main (3D Indigo Micro Badge - Melayang di Bawah Kanan) -->
        <div class="absolute top-28 right-4 lg:top-auto lg:bottom-[10%] lg:-right-6 z-30 pointer-events-auto select-none" data-aos="fade-up" data-aos-delay="600">
          <div class="dev-btn-3d dev-btn-3d-indigo dev-float-5 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-xl sm:rounded-2xl flex items-center justify-center font-mono font-black text-[10px] sm:text-xs tracking-wider cursor-pointer transform hover:scale-115 active:scale-95 transition-all duration-200" title="Git Branch">
            <span class="text-indigo-700 drop-shadow-xs">git:main</span>
          </div>
        </div>

        <!-- Ambient Floating Accent Glow Particle -->
        <div class="absolute top-8 left-14 w-2 sm:w-2.5 h-2 sm:h-2.5 rounded-full bg-sky-400/70 blur-[1px] dev-float-2 pointer-events-none"></div>

        <!-- Person Image Cutout (Desktop only) -->
        <Image
          src={imgHero}
          alt="Aldi Kurniawan"
          class="hidden lg:block w-full h-auto object-contain z-10 drop-shadow-2xl"
          widths={[360, 720]}
          sizes="(max-width: 1024px) 100vw, 360px"
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ========================================================
     SCATTERED 3D DEVELOPER FLOATING TACTILE BUTTONS & CARD
     ======================================================== */
  @keyframes card-float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(0.8deg);
    }
  }

  @keyframes float-1 {
    0%, 100% {
      transform: translateY(0px) rotate(-8deg);
    }
    50% {
      transform: translateY(-11px) rotate(-2deg);
    }
  }

  @keyframes float-2 {
    0%, 100% {
      transform: translateY(0px) rotate(10deg);
    }
    50% {
      transform: translateY(-9px) rotate(4deg);
    }
  }

  @keyframes float-3 {
    0%, 100% {
      transform: translateY(0px) rotate(-7deg);
    }
    50% {
      transform: translateY(-12px) rotate(-11deg);
    }
  }

  @keyframes float-4 {
    0%, 100% {
      transform: translateY(0px) rotate(14deg);
    }
    50% {
      transform: translateY(-10px) rotate(8deg);
    }
  }

  @keyframes float-5 {
    0%, 100% {
      transform: translateY(0px) rotate(-6deg);
    }
    50% {
      transform: translateY(-8px) rotate(2deg);
    }
  }

  .dev-card-float {
    animation: card-float 8s ease-in-out infinite;
    will-change: transform;
  }

  .dev-btn-3d {
    user-select: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .dev-float-1 {
    animation: float-1 4.5s ease-in-out infinite;
    will-change: transform;
  }
  .dev-float-2 {
    animation: float-2 5.5s ease-in-out infinite 0.7s;
    will-change: transform;
  }
  .dev-float-3 {
    animation: float-3 6.2s ease-in-out infinite 1.4s;
    will-change: transform;
  }
  .dev-float-4 {
    animation: float-4 5s ease-in-out infinite 2.1s;
    will-change: transform;
  }
  .dev-float-5 {
    animation: float-5 5.8s ease-in-out infinite 2.8s;
    will-change: transform;
  }

  .dev-btn-3d:hover {
    animation-play-state: paused;
  }

  .dev-btn-3d-blue {
    background: linear-gradient(180deg, #4d8df7 0%, #2b6cef 45%, #1d4ed8 100%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-top: 1.5px solid rgba(255, 255, 255, 0.85);
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.75),
      inset 0 -2.5px 3.5px 0 rgba(10, 30, 95, 0.5),
      0 8px 18px -3px rgba(37, 99, 235, 0.45),
      0 3px 6px -1px rgba(15, 23, 42, 0.18);
  }

  .dev-btn-3d-light {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 45%, #e2e8f0 100%);
    border: 1px solid rgba(203, 213, 225, 0.9);
    border-top: 1.5px solid #ffffff;
    box-shadow: 
      inset 0 2px 2px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.1),
      0 8px 16px -3px rgba(15, 23, 42, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.05);
  }

  .dev-btn-3d-dark {
    background: linear-gradient(180deg, #334155 0%, #1e293b 50%, #0f172a 100%);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1.5px solid rgba(255, 255, 255, 0.5);
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.45),
      inset 0 -2.5px 3.5px 0 rgba(0, 0, 0, 0.6),
      0 8px 18px -3px rgba(15, 23, 42, 0.35),
      0 3px 6px -1px rgba(0, 0, 0, 0.2);
  }

  .dev-btn-3d-emerald {
    background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 45%, #bbf7d0 100%);
    border: 1px solid rgba(52, 211, 153, 0.85);
    border-top: 1.5px solid #ffffff;
    box-shadow: 
      inset 0 2px 2px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(5, 150, 105, 0.2),
      0 8px 16px -3px rgba(16, 185, 129, 0.3),
      0 2px 4px -1px rgba(0, 0, 0, 0.05);
  }

  .dev-btn-3d-indigo {
    background: linear-gradient(180deg, #eef2ff 0%, #e0e7ff 45%, #c7d2fe 100%);
    border: 1px solid rgba(129, 140, 248, 0.85);
    border-top: 1.5px solid #ffffff;
    box-shadow: 
      inset 0 2px 2px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(67, 56, 202, 0.18),
      0 8px 16px -3px rgba(99, 102, 241, 0.3),
      0 2px 4px -1px rgba(0, 0, 0, 0.05);
  }

  /* ========================================================
     3D TIMBUL OVAL FONT EFFECT (HERO SECTION - PERMANENT 3D)
     ======================================================== */
  .hero-name-timbul {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #475569 0%, #1e293b 35%, #0f172a 75%, #020617 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(15, 23, 42, 0.6))
      drop-shadow(3px 4.5px 2px rgba(15, 23, 42, 0.45))
      drop-shadow(0 14px 26px rgba(15, 23, 42, 0.25));
    cursor: default;
    user-select: none;
  }

  .hero-name-timbul-blue {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #93c5fd 0%, #3b82f6 25%, #2563eb 60%, #1d4ed8 85%, #172554 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(30, 58, 138, 0.7))
      drop-shadow(3px 4.5px 2px rgba(29, 78, 216, 0.55))
      drop-shadow(0 16px 30px rgba(37, 99, 235, 0.45));
    cursor: default;
    user-select: none;
  }

  .hero-name-dot {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #475569 0%, #0f172a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(15, 23, 42, 0.6))
      drop-shadow(3px 4.5px 2px rgba(15, 23, 42, 0.45));
  }

  /* 3D Convex Role Badge (Fixed Elevated Look, No Hover/Click Effect) */
  .hero-role-badge-3d {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-weight: 800;
    color: #0f172a;
    user-select: none;
    cursor: default;
    
    /* Fixed 3D Convex Elevated State (as if hovered) */
    background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 45%, #cbd5e1 100%);
    border: 1px solid #94a3b8;
    border-top: 1.5px solid #ffffff;
    
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.12),
      0 10px 20px -3px rgba(0, 0, 0, 0.12),
      0 4px 6px -1px rgba(0, 0, 0, 0.08);
  }
</style>

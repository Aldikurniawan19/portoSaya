---
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);
---

<!-- 5. CONTACT SECTION (HUBUNGI SAYA) -->
<section id="contact" class="py-20 lg:py-28 bg-slate-50 relative overflow-hidden text-slate-600 border-t border-slate-100">
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-30 -z-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-[140px] -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full">
    <!-- Header Badge & Titles -->
    <div class="text-center mb-12 lg:mb-16" data-aos="fade-up">
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-50/90 border border-blue-200/60 rounded-full text-blue-600 text-xs sm:text-sm font-semibold shadow-sm mb-4">
        <i data-lucide="send" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
        <span>{t.contact.badge}</span>
      </div>

      <!-- Main Title -->
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        {t.contact.title}
      </h2>

      <!-- Description -->
      <p class="text-slate-500 mt-3 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        {t.contact.description}
      </p>

      <!-- Accent Line below Description -->
      <div class="w-12 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full mx-auto mt-4 opacity-80"></div>
    </div>

    <!-- Main Grid Container (Left Card + Right Form Card) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      <!-- Left Column: Get In Touch Gradient Card -->
      <div
        class="lg:col-span-5 bg-gradient-to-br from-blue-600 via-indigo-600 to-indigo-900 rounded-3xl p-7 sm:p-8 text-white flex flex-col justify-between shadow-xl shadow-blue-500/15 relative overflow-hidden"
        data-aos="fade-right"
      >
        <!-- Ambient glows inside left card -->
        <div class="absolute -top-24 -right-24 w-60 h-60 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-60 h-60 bg-indigo-500/20 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 space-y-6">
          <!-- Card Title -->
          <div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-white">{t.contact.getInTouch}</h3>
            <div class="w-12 h-1 bg-white/40 rounded-full mt-3"></div>
          </div>

          <!-- Contact Items List -->
          <div class="space-y-3.5">
            <!-- Item 1: Email -->
            <a href="mailto:aldikurniawan19@gmail.com" class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl hover:bg-white/20 transition-all duration-300 group">
              <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform">
                <i data-lucide="mail" class="w-5 h-5"></i>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-white/70 font-semibold uppercase tracking-wider">{t.contact.email}</p>
                <p class="text-sm font-bold text-white truncate">aldikurniawan19@gmail.com</p>
              </div>
            </a>

            <!-- Item 2: Telepon / WhatsApp -->
            <a href="https://wa.me/6285161711904" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl hover:bg-white/20 transition-all duration-300 group">
              <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform">
                <i data-lucide="phone" class="w-5 h-5"></i>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-white/70 font-semibold uppercase tracking-wider">{t.contact.phone}</p>
                <p class="text-sm font-bold text-white truncate">+62 851 6171 1904</p>
              </div>
            </a>

            <!-- Item 3: Location -->
            <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white shrink-0">
                <i data-lucide="map-pin" class="w-5 h-5"></i>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-white/70 font-semibold uppercase tracking-wider">{t.contact.location}</p>
                <p class="text-sm font-bold text-white truncate">{t.contact.locationValue}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Media Icons Footer inside Left Card -->
        <div class="relative z-10 pt-8 mt-6 border-t border-white/15">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-white">{t.contact.followMe}</span>
            <span class="text-[11px] text-white/60 hidden sm:inline">{t.contact.socialSubtext}</span>
          </div>

          <div class="flex items-center gap-3">
            <a href="https://github.com/Aldikurniawan19" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="w-9 h-9 rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center transition-all duration-300 transform hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </a>
            <a href="https://www.instagram.com/aldii_kurniawannnn?igsh=MWJ4c2I3dmIyM3gwdQ==" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center transition-all duration-300 transform hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            </a>
            <a href="#" aria-label="LinkedIn" class="w-9 h-9 rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center transition-all duration-300 transform hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form Card -->
      <div
        class="lg:col-span-7 bg-white rounded-3xl p-7 sm:p-9 border border-slate-200/80 shadow-xl shadow-slate-200/50 flex flex-col justify-between"
        data-aos="fade-left"
      >
        <div>
          <!-- Form Header -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shrink-0">
              <i data-lucide="send" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900">{t.contact.formTitle}</h3>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">{t.contact.formSubtitle}</p>
            </div>
          </div>

          <!-- Form -->
          <form id="contact-form" action="#" method="POST" class="space-y-4" data-success-msg={t.contact.successAlert}>
            <!-- Row 1: Name & Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold text-slate-700 mb-1.5">
                  {t.contact.labelName} <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i data-lucide="user" class="w-4 h-4"></i>
                  </div>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full bg-slate-50/80 border border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-blue-600 focus:bg-white focus:ring-2 focus:ring-blue-600/10 transition-all placeholder-slate-400"
                    placeholder={t.contact.placeholderName}
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-xs font-bold text-slate-700 mb-1.5">
                  {t.contact.labelEmail} <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i data-lucide="mail" class="w-4 h-4"></i>
                  </div>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full bg-slate-50/80 border border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-blue-600 focus:bg-white focus:ring-2 focus:ring-blue-600/10 transition-all placeholder-slate-400"
                    placeholder={t.contact.placeholderEmail}
                  />
                </div>
              </div>
            </div>

            <!-- Row 2: Subject -->
            <div>
              <label for="subject" class="block text-xs font-bold text-slate-700 mb-1.5">
                {t.contact.labelSubject} <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <i data-lucide="tag" class="w-4 h-4"></i>
                </div>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  required
                  class="w-full bg-slate-50/80 border border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-blue-600 focus:bg-white focus:ring-2 focus:ring-blue-600/10 transition-all placeholder-slate-400"
                  placeholder={t.contact.placeholderSubject}
                />
              </div>
            </div>

            <!-- Row 3: Message -->
            <div>
              <label for="message" class="block text-xs font-bold text-slate-700 mb-1.5">
                {t.contact.labelMessage} <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <div class="absolute top-3 left-3.5 flex items-center pointer-events-none text-slate-400">
                  <i data-lucide="message-square" class="w-4 h-4"></i>
                </div>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  class="w-full bg-slate-50/80 border border-slate-200 rounded-xl pl-10 pr-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-blue-600 focus:bg-white focus:ring-2 focus:ring-blue-600/10 transition-all placeholder-slate-400 resize-none"
                  placeholder={t.contact.placeholderMessage}
                ></textarea>
              </div>
            </div>

            <!-- Form Footer Row: Privacy Info Box + Submit Button -->
            <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
              <!-- Privacy Notice Box -->
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 bg-blue-50/70 border border-blue-100 rounded-xl text-xs text-blue-900/80 font-medium">
                <i data-lucide="info" class="w-4 h-4 text-blue-600 shrink-0"></i>
                <span>{t.contact.privacyNotice}</span>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="px-6 py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-bold shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 transition-all flex items-center justify-center gap-2 group cursor-pointer shrink-0"
              >
                <i data-lucide="send" class="w-4 h-4"></i>
                <span>{t.contact.buttonSend}</span>
                <i data-lucide="chevron-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const successMsg = form.getAttribute("data-success-msg") || "Pesan Anda berhasil dikirim! (Demo)";
    alert(successMsg);
  });
</script>

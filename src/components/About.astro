---
import { Image } from 'astro:assets';
import profileImage from '../assets/saya.png';
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);
---

<!-- 2. ABOUT SECTION -->
<section id="about" class="min-h-screen flex items-center relative py-24 overflow-hidden bg-transparent">
  <div class="max-w-6xl mx-auto px-6 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Foto Profil (Kiri, 5 kolom - Hanging Frame with Twine entering Punched Holes) -->
      <div class="lg:col-span-5 relative flex justify-center items-center w-full py-6" data-aos="zoom-in" data-aos-duration="800" data-aos-easing="ease-out-cubic">
        <!-- Wall Hanging Assembly Wrapper -->
        <div class="wall-hanging-assembly relative flex flex-col items-center w-full max-w-[310px] sm:max-w-[350px] select-none">

          <!-- Hanging Frame Container (Tilts naturally) -->
          <div id="about-photo-card" class="hanging-frame-root relative group/photo w-full cursor-pointer z-10 pt-1">
            
            <!-- Realistic Hanging Twine Emerging from Background & Entering Punched Holes SVG -->
            <div class="rope-hanging-wrapper relative w-full z-20 -mb-5 pointer-events-none flex justify-center">
              <svg class="w-full max-w-[310px] sm:max-w-[350px] h-20 sm:h-24 overflow-visible" viewBox="0 0 300 85" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <!-- Rope Wall Drop Shadow Filter -->
                  <filter id="ropeShadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="2.5" dy="5" stdDeviation="2.5" flood-color="#0f172a" flood-opacity="0.35" />
                  </filter>

                  <!-- Hemp Rope Color Gradients -->
                  <linearGradient id="ropeGradLeft" x1="148" y1="5" x2="55" y2="70" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#78350f" />
                    <stop offset="25%" stop-color="#b45309" />
                    <stop offset="65%" stop-color="#d97706" />
                    <stop offset="100%" stop-color="#78350f" />
                  </linearGradient>

                  <linearGradient id="ropeGradRight" x1="152" y1="5" x2="245" y2="70" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#78350f" />
                    <stop offset="25%" stop-color="#b45309" />
                    <stop offset="65%" stop-color="#d97706" />
                    <stop offset="100%" stop-color="#78350f" />
                  </linearGradient>

                  <!-- Dark Hole Cavity Gradient -->
                  <radialGradient id="holeCavity" cx="50%" cy="30%" r="65%">
                    <stop offset="0%" stop-color="#020617" />
                    <stop offset="65%" stop-color="#0f172a" />
                    <stop offset="100%" stop-color="#1e293b" />
                  </radialGradient>
                  
                  <!-- Clean Grommet / Hole Bevel Rim -->
                  <linearGradient id="holeBevelRim" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="40%" stop-color="#e2e8f0" />
                    <stop offset="75%" stop-color="#94a3b8" />
                    <stop offset="100%" stop-color="#475569" />
                  </linearGradient>
                </defs>

                <!-- ================= WALL & FRAME SHADOWS ================= -->
                <g opacity="0.4" filter="url(#ropeShadow)">
                  <!-- Left Rope Shadow -->
                  <path d="M 148 5 Q 96 36 55 66" stroke="#0f172a" stroke-width="5.5" stroke-linecap="round" />
                  <!-- Right Rope Shadow -->
                  <path d="M 152 5 Q 204 36 245 66" stroke="#0f172a" stroke-width="5.5" stroke-linecap="round" />
                </g>

                <!-- ================= WALL OPENING / SLIT WHERE ROPE EMERGES FROM BACKGROUND ================= -->
                <g>
                  <!-- Soft Ambient Drop Shadow of the Wall Opening -->
                  <ellipse cx="150" cy="8.5" rx="14" ry="4.5" fill="#0f172a" opacity="0.25" filter="url(#ropeShadow)" />
                  
                  <!-- Outer Wall Cutout Bevel Rim -->
                  <ellipse cx="150" cy="6" rx="11.5" ry="5" fill="#cbd5e1" opacity="0.6" />
                  <ellipse cx="150" cy="6" rx="11" ry="4.5" fill="url(#holeBevelRim)" stroke="#94a3b8" stroke-width="0.5" />
                  
                  <!-- Deep Dark Void Interior (Behind the Wall) -->
                  <ellipse cx="150" cy="5.5" rx="9" ry="3.5" fill="url(#holeCavity)" />
                  <!-- Deep Shadow at Top of Wall Slit -->
                  <ellipse cx="150" cy="4" rx="8" ry="2" fill="#000000" opacity="0.95" />
                </g>

                <!-- ================= LEFT & RIGHT PUNCHED HOLES (BACKGROUND CAVITY) ================= -->
                <!-- Left Hole (Lobang Kiri di Foto) -->
                <g>
                  <!-- Outer cut-out shadow in white photo paper -->
                  <circle cx="55" cy="70" r="8.5" fill="#cbd5e1" opacity="0.6" />
                  <circle cx="55" cy="70" r="8" fill="url(#holeBevelRim)" stroke="#64748b" stroke-width="0.75" />
                  <!-- Dark Void / Hole Interior -->
                  <circle cx="55" cy="70" r="5.8" fill="url(#holeCavity)" />
                  <!-- Deep shadow inside top of hole -->
                  <ellipse cx="55" cy="67.5" rx="4.8" ry="2.2" fill="#000000" opacity="0.95" />
                </g>

                <!-- Right Hole (Lobang Kanan di Foto) -->
                <g>
                  <!-- Outer cut-out shadow in white photo paper -->
                  <circle cx="245" cy="70" r="8.5" fill="#cbd5e1" opacity="0.6" />
                  <circle cx="245" cy="70" r="8" fill="url(#holeBevelRim)" stroke="#64748b" stroke-width="0.75" />
                  <!-- Dark Void / Hole Interior -->
                  <circle cx="245" cy="70" r="5.8" fill="url(#holeCavity)" />
                  <!-- Deep shadow inside top of hole -->
                  <ellipse cx="245" cy="67.5" rx="4.8" ry="2.2" fill="#000000" opacity="0.95" />
                </g>

                <!-- ================= LEFT ROPE EMERGING FROM WALL SLIT & DIVING INTO HOLE ================= -->
                <g>
                  <!-- Dark Core Base -->
                  <path d="M 148 5 Q 96 36 55 70" stroke="#451a03" stroke-width="5.5" stroke-linecap="round" />
                  <!-- Midtone Hemp Body -->
                  <path d="M 148 5 Q 96 36 55 70" stroke="url(#ropeGradLeft)" stroke-width="4.2" stroke-linecap="round" />
                  <!-- Twisted Strand Texture (Braid Twists) -->
                  <path d="M 148 5 Q 96 36 55 70" stroke="#fde68a" stroke-width="2.6" stroke-dasharray="4 2.8" stroke-linecap="round" stroke-opacity="0.85" />
                  <!-- Counter Strand Highlight -->
                  <path d="M 148 5 Q 96 36 55 70" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 4.8" stroke-linecap="round" stroke-opacity="0.6" />
                </g>

                <!-- ================= RIGHT ROPE EMERGING FROM WALL SLIT & DIVING INTO HOLE ================= -->
                <g>
                  <!-- Dark Core Base -->
                  <path d="M 152 5 Q 204 36 245 70" stroke="#451a03" stroke-width="5.5" stroke-linecap="round" />
                  <!-- Midtone Hemp Body -->
                  <path d="M 152 5 Q 204 36 245 70" stroke="url(#ropeGradRight)" stroke-width="4.2" stroke-linecap="round" />
                  <!-- Twisted Strand Texture (Braid Twists) -->
                  <path d="M 152 5 Q 204 36 245 70" stroke="#fde68a" stroke-width="2.6" stroke-dasharray="4 2.8" stroke-linecap="round" stroke-opacity="0.85" />
                  <!-- Counter Strand Highlight -->
                  <path d="M 152 5 Q 204 36 245 70" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 4.8" stroke-linecap="round" stroke-opacity="0.6" />
                </g>

                <!-- ================= FOREGROUND WALL SLIT & HOLE OVERLAYS ================= -->
                <!-- Top Wall Opening Rim Overlay (Clips over the emerging ropes) -->
                <g>
                  <!-- Shadow cast over rope as it exits the wall slit -->
                  <path d="M 141 5.5 C 141 2.5, 159 2.5, 159 5.5" stroke="#000000" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
                  <!-- Subtle Bottom Lip Highlight of Wall Opening -->
                  <path d="M 141 6 C 144 8.5, 156 8.5, 159 6" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" opacity="0.9" />
                </g>

                <!-- Left Hole Foreground Rim Overlay -->
                <g>
                  <!-- Bottom & side rim of the hole drawn in front of the entering rope -->
                  <path d="M 47 70 A 8 8 0 0 0 63 70" stroke="url(#holeBevelRim)" stroke-width="1.6" fill="none" stroke-linecap="round" />
                  <!-- Specular highlight on bottom paper edge -->
                  <path d="M 48.5 71 A 6.5 6.5 0 0 0 61.5 71" stroke="#ffffff" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-opacity="0.85" />
                  <!-- Shadow cast over rope as it enters the hole -->
                  <path d="M 50 66 Q 55 68 60 66" stroke="#000000" stroke-width="2.5" stroke-linecap="round" stroke-opacity="0.65" />
                </g>

                <!-- Right Hole Foreground Rim Overlay -->
                <g>
                  <!-- Bottom & side rim of the hole drawn in front of the entering rope -->
                  <path d="M 237 70 A 8 8 0 0 0 253 70" stroke="url(#holeBevelRim)" stroke-width="1.6" fill="none" stroke-linecap="round" />
                  <!-- Specular highlight on bottom paper edge -->
                  <path d="M 238.5 71 A 6.5 6.5 0 0 0 251.5 71" stroke="#ffffff" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-opacity="0.85" />
                  <!-- Shadow cast over rope as it enters the hole -->
                  <path d="M 240 66 Q 245 68 250 66" stroke="#000000" stroke-width="2.5" stroke-linecap="round" stroke-opacity="0.65" />
                </g>
              </svg>
            </div>

            <!-- Outer Picture Frame Shell (Tilted Gallery Frame) -->
            <div class="photo-frame-body relative rounded-3xl p-3 sm:p-3.5 bg-gradient-to-b from-white via-slate-50 to-slate-200/90 border border-white/95 shadow-nailed-frame transition-all duration-300 transform-gpu group-hover/photo:shadow-nailed-frame-hover">
              
              <!-- Inner Matting / Passe-Partout Bevel Border -->
              <div class="relative rounded-2xl p-1 bg-white shadow-[inset_0_1.5px_2px_rgba(255,255,255,1),inset_0_-1px_2px_rgba(0,0,0,0.06),0_1px_3px_rgba(15,23,42,0.08)] border border-slate-100">
                
                <!-- Inner Photo Container -->
                <div class="relative rounded-xl overflow-hidden aspect-[4/5] bg-gradient-to-br from-slate-900 to-blue-950 shadow-[inset_0_2px_6px_rgba(0,0,0,0.4)]">
                  <Image
                    src={profileImage}
                    alt={t.about.name}
                    class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover/photo:scale-105"
                    widths={[340, 680]}
                    sizes="(max-width: 640px) 340px, 380px"
                    format="webp"
                    quality={85}
                    loading="lazy"
                    decoding="async"
                  />

                  <!-- Dynamic Interactive Spotlight / Sheen Glare -->
                  <div id="photo-glare" class="absolute inset-0 pointer-events-none opacity-0 group-hover/photo:opacity-100 transition-opacity duration-300 rounded-xl"></div>

                  <!-- Diagonal Glass Sheen Reflection -->
                  <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.08] to-white/[0.22] pointer-events-none"></div>

                  <!-- Subtle Gradient Vignette at bottom -->
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent opacity-70 group-hover/photo:opacity-20 transition-opacity duration-500 pointer-events-none"></div>

                  <!-- Top Gloss Highlight Streak -->
                  <div class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-white/25 to-transparent pointer-events-none"></div>
                </div>
              </div>

              <!-- Decorative Brass / Silver Frame Corner Accents -->
              <div class="absolute top-2.5 left-2.5 w-2.5 h-2.5 border-t-2 border-l-2 border-slate-400/50 rounded-tl-sm pointer-events-none"></div>
              <div class="absolute top-2.5 right-2.5 w-2.5 h-2.5 border-t-2 border-r-2 border-slate-400/50 rounded-tr-sm pointer-events-none"></div>
              <div class="absolute bottom-2.5 left-2.5 w-2.5 h-2.5 border-b-2 border-l-2 border-slate-400/50 rounded-bl-sm pointer-events-none"></div>
              <div class="absolute bottom-2.5 right-2.5 w-2.5 h-2.5 border-b-2 border-r-2 border-slate-400/50 rounded-br-sm pointer-events-none"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Data Diri (Kanan, 7 kolom) -->
      <div class="lg:col-span-7 space-y-6 flex flex-col justify-center">
        <!-- Title Badge Row -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-3xl sm:text-4xl md:text-5xl font-black tracking-tight py-1">
            <span class="about-badge-timbul">{t.about.badge}</span>
            <span class="about-name-timbul-blue">{t.about.name}</span>
          </div>
          <div class="btn-3d-emerald px-4 sm:px-5 py-2 text-xs sm:text-sm font-extrabold tracking-wider w-fit uppercase select-none">
            {t.about.role}
          </div>
        </div>

        <!-- Bordered Paragraphs with Fade-In From Left to Right -->
        <div id="about-text-container" class="border-l-4 border-indigo-500 pl-6 space-y-4">
          <p
            id="about-text-1"
            class="text-slate-600 leading-relaxed text-base font-medium opacity-0 -translate-x-8 transition-all duration-1000 ease-out will-change-[transform,opacity]"
          >
            {t.about.paragraph1}
          </p>
          <p
            id="about-text-2"
            class="text-slate-600 leading-relaxed text-base font-medium opacity-0 -translate-x-8 transition-all duration-1000 ease-out delay-300 will-change-[transform,opacity]"
          >
            {t.about.paragraph2}
          </p>
        </div>

        <!-- Action Button -->
        <div class="pt-2">
          <a href="#" class="btn-3d-blue px-7 py-3.5 text-sm md:text-base font-bold w-fit">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span>{t.about.downloadCV}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initAboutFadeReveal() {
    const p1 = document.getElementById("about-text-1");
    const p2 = document.getElementById("about-text-2");
    const container = document.getElementById("about-text-container");
    if (!p1 || !p2 || !container) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          p1.classList.remove("opacity-0", "-translate-x-8");
          p1.classList.add("opacity-100", "translate-x-0");

          p2.classList.remove("opacity-0", "-translate-x-8");
          p2.classList.add("opacity-100", "translate-x-0");

          observer.disconnect();
        }
      });
    }, { rootMargin: "0px 0px -50px 0px", threshold: 0.25 });

    observer.observe(container);
  }

  // 3D Parallax Tilt, Slight Slanted Angle & Light Glare Script
  function initAboutPhotoTilt() {
    const card = document.getElementById("about-photo-card");
    const glare = document.getElementById("photo-glare");
    if (!card) return;

    // Base resting tilt angle (mereng/miring natural hanging angle)
    const BASE_TILT = -3.8;

    // Initial transform setup
    card.style.transformOrigin = "50% 0px";
    card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) rotateZ(${BASE_TILT}deg) scale3d(1, 1, 1)`;

    // Only enable mouse interactive tilt on desktop pointer devices
    if (!window.matchMedia('(pointer: fine)').matches) return;

    let isHovered = false;
    let tiltTicking = false;

    card.addEventListener("mouseenter", () => {
      isHovered = true;
      card.style.transition = "transform 0.12s ease-out, box-shadow 0.3s ease";
    });

    card.addEventListener("mousemove", (e) => {
      if (!isHovered) return;
      if (!tiltTicking) {
        requestAnimationFrame(() => {
          if (!isHovered) {
            tiltTicking = false;
            return;
          }
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;

          // Calculate tilt angles relative to hanging anchor
          const rotateX = ((y - centerY) / centerY) * -7;
          const rotateY = ((x - centerX) / centerX) * 7;
          const rotateZ = BASE_TILT + ((x - centerX) / centerX) * 2.2;

          card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) rotateZ(${rotateZ.toFixed(2)}deg) scale3d(1.025, 1.025, 1.025)`;

          if (glare) {
            glare.style.background = `radial-gradient(circle 280px at ${x}px ${y}px, rgba(255, 255, 255, 0.35), transparent 70%)`;
          }
          tiltTicking = false;
        });
        tiltTicking = true;
      }
    }, { passive: true });

    card.addEventListener("mouseleave", () => {
      isHovered = false;
      tiltTicking = false;
      card.style.transition = "transform 0.7s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s ease";
      card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) rotateZ(${BASE_TILT}deg) scale3d(1, 1, 1)`;
    });
  }

  function initAboutModule() {
    initAboutFadeReveal();
    initAboutPhotoTilt();
  }

  // Load modules
  initAboutModule();
  document.addEventListener("astro:page-load", initAboutModule);
</script>

<style is:global>
  /* ========================================================
     WALL NAILED & TILTED PHOTO FRAME STYLES
     ======================================================== */
  .hanging-frame-root {
    transform-origin: 50% 0px;
    transform: perspective(1000px) rotateZ(-3.8deg);
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s ease;
  }

  /* Realistic Wall Cast Shadow for Nailed Hanging Frame */
  .shadow-nailed-frame {
    box-shadow: 
      14px 28px 45px -8px rgba(15, 23, 42, 0.22),
      4px 10px 18px -4px rgba(15, 23, 42, 0.12),
      inset 0 2.5px 3px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 4px 0 rgba(0, 0, 0, 0.07);
  }

  .shadow-nailed-frame-hover {
    box-shadow: 
      18px 36px 55px -10px rgba(37, 99, 235, 0.25),
      6px 16px 24px -4px rgba(15, 23, 42, 0.16),
      inset 0 2.5px 3px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 4px 0 rgba(0, 0, 0, 0.07);
  }

  /* ========================================================
     3D TIMBUL FONT EFFECT (ABOUT SECTION - PURE TEXT NO BG)
     ======================================================== */
  .about-badge-timbul {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #475569 0%, #1e293b 35%, #0f172a 75%, #020617 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(15, 23, 42, 0.6))
      drop-shadow(3px 4.5px 2px rgba(15, 23, 42, 0.45))
      drop-shadow(0 14px 26px rgba(15, 23, 42, 0.25));
    cursor: default;
    user-select: none;
  }

  .about-name-timbul-blue {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #93c5fd 0%, #3b82f6 25%, #2563eb 60%, #1d4ed8 85%, #172554 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(30, 58, 138, 0.7))
      drop-shadow(3px 4.5px 2px rgba(29, 78, 216, 0.55))
      drop-shadow(0 16px 30px rgba(37, 99, 235, 0.45));
    cursor: default;
    user-select: none;
  }

  /* ========================================================
     3D CONVEX ROLE BADGE (FIXED ELEVATED LOOK, NO HOVER/CLICK)
     ======================================================== */
  .btn-3d-emerald {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 9999px;
    font-weight: 800;
    color: #065f46;
    user-select: none;
    cursor: default;
    
    /* Fixed 3D Convex Emerald Elevated State (as if hovered) */
    background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 45%, #bbf7d0 100%);
    border: 1px solid rgba(52, 211, 153, 0.75);
    border-top: 1.5px solid rgba(255, 255, 255, 1);
    
    /* 3D Convex Lighting: Specular Top Highlight + Bottom Ambient Shadow + Elevation Shadow */
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(5, 150, 105, 0.18),
      0 10px 22px -3px rgba(16, 185, 129, 0.38),
      0 4px 8px -1px rgba(15, 23, 42, 0.12);
    
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.7);
  }
</style>






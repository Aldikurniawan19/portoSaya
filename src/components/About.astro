---
import { Image } from 'astro:assets';
import profileImage from '../assets/saya.png';
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);
---

<!-- 2. ABOUT SECTION -->
<section id="about" class="min-h-screen flex items-center relative py-24 overflow-hidden bg-transparent">
  <div class="max-w-6xl mx-auto px-6 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Foto Profil (Kiri, 5 kolom - Clean 3D Photo Display) -->
      <div class="lg:col-span-5 relative flex justify-center items-center w-full py-4" data-aos="zoom-in" data-aos-duration="800" data-aos-easing="ease-out-cubic">
        <!-- Interactive 3D Perspective Photo Card Container -->
        <div id="about-photo-card" class="relative group/photo w-full max-w-[320px] sm:max-w-[360px] select-none perspective-[1000px] cursor-pointer z-10">
          <!-- Outer 3D Convex Frame Shell with Dynamic Tilt -->
          <div class="photo-3d-wrapper relative rounded-3xl p-3 sm:p-3.5 bg-gradient-to-b from-white/95 via-slate-100/90 to-slate-200/95 border border-white/90 shadow-[0_20px_50px_-10px_rgba(15,23,42,0.15),inset_0_2.5px_3px_0_rgba(255,255,255,1),inset_0_-2px_4px_0_rgba(0,0,0,0.06)] backdrop-blur-md transition-all duration-300 transform-gpu group-hover/photo:shadow-[0_25px_60px_-10px_rgba(37,99,235,0.25)]">
            
            <!-- Photo Inner Container -->
            <div class="relative rounded-2xl overflow-hidden aspect-[4/5] bg-gradient-to-br from-slate-900 to-blue-950 shadow-inner">
              <Image
                src={profileImage}
                alt={t.about.name}
                class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover/photo:scale-105"
                widths={[340, 680]}
                sizes="(max-width: 640px) 340px, 380px"
              />

              <!-- Dynamic Interactive Spotlight / Sheen Glare -->
              <div id="photo-glare" class="absolute inset-0 pointer-events-none opacity-0 group-hover/photo:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

              <!-- Subtle Gradient Vignette at bottom -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent opacity-60 group-hover/photo:opacity-20 transition-opacity duration-500 pointer-events-none"></div>

              <!-- Top Gloss Highlight Streak -->
              <div class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-white/20 to-transparent pointer-events-none"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Data Diri (Kanan, 7 kolom) -->
      <div class="lg:col-span-7 space-y-6 flex flex-col justify-center">
        <!-- Title Badge Row -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-3xl sm:text-4xl md:text-5xl font-black tracking-tight py-1">
            <span class="about-badge-timbul">{t.about.badge}</span>
            <span class="about-name-timbul-blue">{t.about.name}</span>
          </div>
          <div class="btn-3d-emerald px-4 sm:px-5 py-2 text-xs sm:text-sm font-extrabold tracking-wider w-fit uppercase select-none">
            {t.about.role}
          </div>
        </div>

        <!-- Bordered Paragraphs with Fade-In From Left to Right -->
        <div id="about-text-container" class="border-l-4 border-indigo-500 pl-6 space-y-4">
          <p
            id="about-text-1"
            class="text-slate-600 leading-relaxed text-base font-medium opacity-0 -translate-x-8 transition-all duration-1000 ease-out will-change-[transform,opacity]"
          >
            {t.about.paragraph1}
          </p>
          <p
            id="about-text-2"
            class="text-slate-600 leading-relaxed text-base font-medium opacity-0 -translate-x-8 transition-all duration-1000 ease-out delay-300 will-change-[transform,opacity]"
          >
            {t.about.paragraph2}
          </p>
        </div>

        <!-- Action Button -->
        <div class="pt-2">
          <a href="#" class="btn-3d-blue px-7 py-3.5 text-sm md:text-base font-bold w-fit">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span>{t.about.downloadCV}</span>
            <i data-lucide="chevron-right" class="w-4 h-4 opacity-80"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initAboutFadeReveal() {
    const p1 = document.getElementById("about-text-1");
    const p2 = document.getElementById("about-text-2");
    const container = document.getElementById("about-text-container");
    if (!p1 || !p2 || !container) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          p1.classList.remove("opacity-0", "-translate-x-8");
          p1.classList.add("opacity-100", "translate-x-0");

          p2.classList.remove("opacity-0", "-translate-x-8");
          p2.classList.add("opacity-100", "translate-x-0");

          observer.disconnect();
        }
      });
    }, { rootMargin: "0px 0px -50px 0px", threshold: 0.25 });

    observer.observe(container);
  }

  // 3D Parallax Tilt & Light Glare Script (Desktop only)
  function initAboutPhotoTilt() {
    // Only enable on desktop pointer devices
    if (!window.matchMedia('(pointer: fine)').matches) return;

    const card = document.getElementById("about-photo-card");
    const wrapper = card?.querySelector(".photo-3d-wrapper") as HTMLElement | null;
    const glare = document.getElementById("photo-glare");
    if (!card || !wrapper) return;

    let isHovered = false;

    card.addEventListener("mouseenter", () => {
      isHovered = true;
      wrapper.style.transition = "transform 0.15s ease-out, box-shadow 0.3s ease";
    });

    card.addEventListener("mousemove", (e) => {
      if (!isHovered) return;
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // Calculate tilt angles
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;

      wrapper.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

      if (glare) {
        glare.style.background = `radial-gradient(circle 260px at ${x}px ${y}px, rgba(255, 255, 255, 0.35), transparent 70%)`;
      }
    });

    card.addEventListener("mouseleave", () => {
      isHovered = false;
      wrapper.style.transition = "transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s ease";
      wrapper.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)";
    });
  }

  function initAboutModule() {
    initAboutFadeReveal();
    initAboutPhotoTilt();
  }

  // Load modules
  initAboutModule();
  document.addEventListener("astro:page-load", initAboutModule);
</script>

<style is:global>
  /* ========================================================
     3D TIMBUL FONT EFFECT (ABOUT SECTION - PURE TEXT NO BG)
     ======================================================== */
  .about-badge-timbul {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #475569 0%, #1e293b 35%, #0f172a 75%, #020617 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(15, 23, 42, 0.6))
      drop-shadow(3px 4.5px 2px rgba(15, 23, 42, 0.45))
      drop-shadow(0 14px 26px rgba(15, 23, 42, 0.25));
    cursor: default;
    user-select: none;
  }

  .about-name-timbul-blue {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #93c5fd 0%, #3b82f6 25%, #2563eb 60%, #1d4ed8 85%, #172554 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(30, 58, 138, 0.7))
      drop-shadow(3px 4.5px 2px rgba(29, 78, 216, 0.55))
      drop-shadow(0 16px 30px rgba(37, 99, 235, 0.45));
    cursor: default;
    user-select: none;
  }

  /* ========================================================
     3D CONVEX BUTTON (ROLE BADGE - KEEPING EMERALD PALETTE)
     ======================================================== */
  .btn-3d-emerald {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 9999px;
    font-weight: 800;
    color: #065f46;
    user-select: none;
    cursor: default;
    
    /* 3D Convex Emerald Gradient Base */
    background: linear-gradient(180deg, #ecfdf5 0%, #d1fae5 45%, #a7f3d0 100%);
    border: 1px solid rgba(52, 211, 153, 0.55);
    border-top: 1.5px solid rgba(255, 255, 255, 0.95);
    
    /* 3D Convex Lighting: Specular Top Highlight + Bottom Ambient Shadow + Elevation Shadow */
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.95),
      inset 0 -2.5px 3.5px 0 rgba(5, 150, 105, 0.22),
      0 6px 14px -2px rgba(16, 185, 129, 0.28),
      0 2px 5px -1px rgba(15, 23, 42, 0.08);
    
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.7);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-3d-emerald:hover {
    background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 45%, #bbf7d0 100%);
    border-color: rgba(52, 211, 153, 0.75);
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(5, 150, 105, 0.18),
      0 10px 22px -3px rgba(16, 185, 129, 0.38),
      0 4px 8px -1px rgba(15, 23, 42, 0.12);
    transform: translateY(-1.5px);
  }
</style>






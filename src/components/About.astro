---
import { Image } from 'astro:assets';
import profileImage from '../assets/saya.png';
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);
---

<!-- 2. ABOUT SECTION -->
<section id="about" class="min-h-screen flex items-center bg-transparent relative py-24 overflow-visible">
  <div class="max-w-6xl mx-auto px-6 w-full overflow-visible">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center overflow-visible">
      <!-- Foto Profil (Kiri, 5 kolom) -->
      <div class="lg:col-span-5 relative flex justify-center items-center w-full py-8 overflow-visible" data-aos="zoom-in" data-aos-duration="800" data-aos-easing="ease-out-cubic">
        <!-- Interactive 3D Perspective Photo Card Container -->
        <div id="about-photo-card" class="relative group/photo w-full max-w-[320px] sm:max-w-[360px] select-none perspective-[1000px] cursor-pointer animate-float-ambient z-10">
          
          <!-- Outer Revolving Conic Glow Ring -->
          <div class="absolute -inset-1.5 rounded-[32px] overflow-hidden opacity-75 group-hover/photo:opacity-100 transition-opacity duration-500 blur-sm pointer-events-none">
            <div class="conic-glow-spinner"></div>
          </div>

          <!-- Futuristic Cyber HUD Corner Accents -->
          <div class="absolute -top-2 -left-2 w-5 h-5 border-t-2 border-l-2 border-cyan-400 rounded-tl-lg pointer-events-none transition-all duration-300 group-hover/photo:-top-3 group-hover/photo:-left-3 group-hover/photo:border-cyan-300 group-hover/photo:shadow-[0_0_10px_#00ffff] group-hover/photo:w-6 group-hover/photo:h-6 z-20"></div>
          <div class="absolute -top-2 -right-2 w-5 h-5 border-t-2 border-r-2 border-cyan-400 rounded-tr-lg pointer-events-none transition-all duration-300 group-hover/photo:-top-3 group-hover/photo:-right-3 group-hover/photo:border-cyan-300 group-hover/photo:shadow-[0_0_10px_#00ffff] group-hover/photo:w-6 group-hover/photo:h-6 z-20"></div>
          <div class="absolute -bottom-2 -left-2 w-5 h-5 border-b-2 border-l-2 border-cyan-400 rounded-bl-lg pointer-events-none transition-all duration-300 group-hover/photo:-bottom-3 group-hover/photo:-left-3 group-hover/photo:border-cyan-300 group-hover/photo:shadow-[0_0_10px_#00ffff] group-hover/photo:w-6 group-hover/photo:h-6 z-20"></div>
          <div class="absolute -bottom-2 -right-2 w-5 h-5 border-b-2 border-r-2 border-cyan-400 rounded-br-lg pointer-events-none transition-all duration-300 group-hover/photo:-bottom-3 group-hover/photo:-right-3 group-hover/photo:border-cyan-300 group-hover/photo:shadow-[0_0_10px_#00ffff] group-hover/photo:w-6 group-hover/photo:h-6 z-20"></div>

          <!-- Outer 3D Convex Frame Shell with Dynamic Tilt -->
          <div class="photo-3d-wrapper relative rounded-3xl p-3 sm:p-3.5 bg-gradient-to-b from-white/95 via-slate-100/90 to-slate-200/95 border border-white/90 shadow-[0_20px_50px_-10px_rgba(15,23,42,0.15),inset_0_2.5px_3px_0_rgba(255,255,255,1),inset_0_-2px_4px_0_rgba(0,0,0,0.06)] backdrop-blur-md transition-all duration-300 transform-gpu group-hover/photo:shadow-[0_30px_70px_-10px_rgba(6,182,212,0.45)]">
            
            <!-- Photo Inner Container -->
            <div class="relative rounded-2xl overflow-hidden aspect-[4/5] bg-gradient-to-br from-slate-900 to-blue-950 shadow-inner">
              <Image
                src={profileImage}
                alt={t.about.name}
                class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover/photo:scale-105"
                widths={[340, 680]}
                sizes="(max-width: 640px) 340px, 380px"
              />

              <!-- Laser Scanline Beam Animation -->
              <div class="laser-scanline pointer-events-none"></div>

              <!-- Dynamic Interactive Spotlight / Sheen Glare -->
              <div id="photo-glare" class="absolute inset-0 pointer-events-none opacity-0 group-hover/photo:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

              <!-- Subtle Gradient Vignette at bottom -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent opacity-60 group-hover/photo:opacity-20 transition-opacity duration-500 pointer-events-none"></div>

              <!-- Top Gloss Highlight Streak -->
              <div class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-white/20 to-transparent pointer-events-none"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Data Diri (Kanan, 7 kolom) -->
      <div class="lg:col-span-7 space-y-6 flex flex-col justify-center">
        <!-- Title Badge Row -->
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-3xl md:text-4xl font-extrabold text-secondary tracking-tight">
            <span>{t.about.badge}</span>
            <span class="bg-[#3b82f6] text-white px-4 py-1.5 rounded-xl text-2xl md:text-3xl font-extrabold tracking-wide uppercase">{t.about.name}</span>
          </div>
          <div class="bg-[#10b981]/25 text-[#065f46] px-4 py-2 rounded-xl text-sm md:text-base font-black tracking-wider w-fit border border-[#10b981]/30">
            {t.about.role}
          </div>
        </div>

        <!-- Bordered Paragraphs -->
        <div class="border-l-4 border-indigo-500 pl-6 space-y-4">
          <p id="about-text-1" class="text-slate-600 leading-relaxed text-base font-medium" data-text={t.about.paragraph1}>
            {t.about.paragraph1}
          </p>
          <p id="about-text-2" class="text-slate-600 leading-relaxed text-base font-medium" data-text={t.about.paragraph2}>
            {t.about.paragraph2}
          </p>
        </div>

        <!-- Action Button -->
        <div class="pt-2">
          <a href="#" class="btn-3d-blue px-7 py-3.5 text-sm md:text-base font-bold w-fit">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span>{t.about.downloadCV}</span>
            <i data-lucide="chevron-right" class="w-4 h-4 opacity-80"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initAboutTypewriter() {
    const p1 = document.getElementById("about-text-1");
    const p2 = document.getElementById("about-text-2");
    if (!p1 || !p2) return;

    // Grab correct text content from data attributes or innerText
    const text1 = p1.getAttribute("data-text") || p1.innerText.trim();
    const text2 = p2.getAttribute("data-text") || p2.innerText.trim();

    // Ensure data attribute contains the clean text
    p1.setAttribute("data-text", text1);
    p2.setAttribute("data-text", text2);

    // Empty contents initially
    p1.innerHTML = "";
    p2.innerHTML = "";

    // Create a blinking cursor element
    const cursor = document.createElement("span");
    cursor.className = "inline-block w-[2px] h-[1em] bg-indigo-500 ml-1 align-middle animate-pulse";
    cursor.style.animationDuration = "0.8s";

    let hasStarted = false;

    // Setup intersection observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !hasStarted) {
          hasStarted = true;
          startTyping();
          observer.disconnect();
        }
      });
    }, { rootMargin: "-10% 0px -15% 0px", threshold: 0.1 });

    const aboutSection = document.getElementById("about");
    if (aboutSection) {
      observer.observe(aboutSection);
    }

    function startTyping() {
      let index1 = 0;
      let index2 = 0;
      const speed = 20; // Typing speed in ms per character (fast and smooth)

      function typeP1() {
        if (!p1) return;
        if (index1 < text1.length) {
          p1.innerHTML = text1.substring(0, index1 + 1);
          p1.appendChild(cursor);
          index1++;
          setTimeout(typeP1, speed);
        } else {
          // Remove cursor from p1
          if (p1.contains(cursor)) {
            p1.removeChild(cursor);
          }
          // Start p2
          setTimeout(typeP2, 200);
        }
      }

      function typeP2() {
        if (!p2) return;
        if (index2 < text2.length) {
          p2.innerHTML = text2.substring(0, index2 + 1);
          p2.appendChild(cursor);
          index2++;
          setTimeout(typeP2, speed);
        } else {
          // Keep cursor blinking for 2 seconds after completion, then remove
          setTimeout(() => {
            if (p2.contains(cursor)) {
              p2.removeChild(cursor);
            }
          }, 2000);
        }
      }

      typeP1();
    }
  }

  // 3D Parallax Tilt & Light Glare Script
  function initAboutPhotoTilt() {
    const card = document.getElementById("about-photo-card");
    const wrapper = card?.querySelector(".photo-3d-wrapper") as HTMLElement | null;
    const glare = document.getElementById("photo-glare");
    if (!card || !wrapper) return;

    let isHovered = false;

    card.addEventListener("mouseenter", () => {
      isHovered = true;
      wrapper.style.transition = "transform 0.15s ease-out, box-shadow 0.3s ease";
    });

    card.addEventListener("mousemove", (e) => {
      if (!isHovered) return;
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // Calculate tilt angles (Max +- 12deg)
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;

      wrapper.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

      if (glare) {
        glare.style.background = `radial-gradient(circle 260px at ${x}px ${y}px, rgba(255, 255, 255, 0.35), transparent 70%)`;
      }
    });

    card.addEventListener("mouseleave", () => {
      isHovered = false;
      wrapper.style.transition = "transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s ease";
      wrapper.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)";
    });
  }

  function initAboutModule() {
    initAboutTypewriter();
    initAboutPhotoTilt();
    if (typeof (window as any).lucide !== "undefined") {
      (window as any).lucide.createIcons();
    }
  }

  // Load modules
  initAboutModule();
  // Support Astro SPA transition events
  document.addEventListener("astro:page-load", initAboutModule);
</script>

<style>
  /* Conic Glowing Ring */
  .conic-glow-spinner {
    position: absolute;
    inset: -60%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(6, 182, 212, 0.95) 90deg,
      rgba(59, 130, 246, 0.95) 180deg,
      rgba(0, 240, 255, 0.95) 270deg,
      transparent 360deg
    );
    animation: spin-conic 6s linear infinite;
  }

  @keyframes spin-conic {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Ambient Floating Levitation */
  .animate-float-ambient {
    animation: float-ambient 6s ease-in-out infinite;
  }

  @keyframes float-ambient {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Laser Scanline Beam */
  .laser-scanline {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(6, 182, 212, 0.8) 20%,
      rgba(255, 255, 255, 0.95) 50%,
      rgba(59, 130, 246, 0.8) 80%,
      transparent 100%
    );
    box-shadow: 0 0 12px 2px rgba(6, 182, 212, 0.6);
    opacity: 0;
    animation: scanline-sweep 4.5s ease-in-out infinite;
  }

  @keyframes scanline-sweep {
    0% {
      top: -5%;
      opacity: 0;
    }
    10% {
      opacity: 0.85;
    }
    90% {
      opacity: 0.85;
    }
    100% {
      top: 105%;
      opacity: 0;
    }
  }
</style>




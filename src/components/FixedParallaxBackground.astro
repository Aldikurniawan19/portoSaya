---
// FIXED GLOBAL HERO BACKGROUND CANVAS (Layer Paling Belakang / Fixed Parallax Canvas)
---

<div class="fixed inset-0 -z-50 pointer-events-none overflow-hidden contain-paint select-none transform-gpu will-change-transform">
  <!-- Background Grid Pattern with Mask -->
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-80 contain-strict">
    <!-- Horizontal Beams (GPU Accelerated across the entire viewport on Mobile & Desktop) -->
    <div
      class="absolute h-[3.5px] sm:h-[4px] w-[180px] sm:w-[240px] rounded-full bg-gradient-to-r from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="top: 14vh; animation: beam-h 7.5s linear infinite; animation-delay: 0s;"
    ></div>
    <div
      class="absolute h-[3.5px] sm:h-[4px] w-[180px] sm:w-[240px] rounded-full bg-gradient-to-l from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="top: 36vh; animation: beam-h-reverse 8.5s linear infinite; animation-delay: 1.8s;"
    ></div>
    <div
      class="absolute h-[3.5px] sm:h-[4px] w-[180px] sm:w-[240px] rounded-full bg-gradient-to-r from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="top: 58vh; animation: beam-h 9s linear infinite; animation-delay: 3.5s;"
    ></div>
    <div
      class="absolute h-[3.5px] sm:h-[4px] w-[180px] sm:w-[240px] rounded-full bg-gradient-to-l from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="top: 80vh; animation: beam-h-reverse 10s linear infinite; animation-delay: 0.8s;"
    ></div>
    <div
      class="absolute h-[3.5px] sm:h-[4px] w-[180px] sm:w-[240px] rounded-full bg-gradient-to-r from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="top: 92vh; animation: beam-h 8s linear infinite; animation-delay: 2.5s;"
    ></div>

    <!-- Vertical Beams (GPU Accelerated across the entire viewport on Mobile & Desktop) -->
    <div
      class="absolute w-[3.5px] sm:w-[4px] h-[180px] sm:h-[240px] rounded-full bg-gradient-to-b from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="left: 12vw; animation: beam-v 8s linear infinite; animation-delay: 0.5s;"
    ></div>
    <div
      class="absolute w-[3.5px] sm:w-[4px] h-[180px] sm:h-[240px] rounded-full bg-gradient-to-t from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="left: 36vw; animation: beam-v-reverse 9.5s linear infinite; animation-delay: 2.5s;"
    ></div>
    <div
      class="absolute w-[3.5px] sm:w-[4px] h-[180px] sm:h-[240px] rounded-full bg-gradient-to-b from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="left: 62vw; animation: beam-v 8.5s linear infinite; animation-delay: 4.2s;"
    ></div>
    <div
      class="absolute w-[3.5px] sm:w-[4px] h-[180px] sm:h-[240px] rounded-full bg-gradient-to-t from-transparent via-blue-500 via-sky-400 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.7)] will-change-transform"
      style="left: 86vw; animation: beam-v-reverse 10s linear infinite; animation-delay: 1.2s;"
    ></div>
  </div>

  <!-- Ambient Glowing Background Spheres (Atmospheric depth) -->
  <div class="absolute -top-32 -left-32 w-[600px] h-[600px] bg-blue-500/10 rounded-full blur-[140px]"></div>
  <div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-indigo-500/10 rounded-full blur-[140px]"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-sky-500/5 rounded-full blur-[120px]"></div>

  <!-- REALISTIC GLASS TEXTURE & SPECULAR SHEEN SYSTEM -->
  <!-- 1. Base Glass Tint & Diagonal Specular Sheen (Pantulan Cahaya Diagonal Kaca) -->
  <div class="absolute inset-0 bg-[linear-gradient(125deg,rgba(255,255,255,0.22)_0%,rgba(255,255,255,0.06)_30%,rgba(255,255,255,0.18)_50%,rgba(255,255,255,0.04)_75%,rgba(255,255,255,0.16)_100%)] pointer-events-none"></div>

  <!-- 2. Micro Fine Glass Grain Texture (Tekstur Fisik Silika Kaca Tempered) -->
  <div
    class="absolute inset-0 opacity-[0.038] mix-blend-overlay pointer-events-none"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E'); background-repeat: repeat;"
  ></div>

  <!-- 3. Glass Prism Light Reflections (Kilauan Bias Cahaya Permukaan Kaca) -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(255,255,255,0.35),rgba(255,255,255,0)_70%)] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_85%_95%,rgba(59,130,246,0.06),rgba(255,255,255,0)_70%)] pointer-events-none"></div>
</div>


---
import { Image } from 'astro:assets';
import projectImage from '../assets/projek1.png';
import rentalImage from '../assets/rentalimg.png';
import hotelImage from '../assets/projek2.png';
import barberImage from '../assets/projek3.png';
import ramadhanImage from '../assets/projek4.png';
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);

const projects = [
  {
    title: "All.Dev - Modern Developer Portfolio",
    badge: t.portfolio.badge,
    image: projectImage,
    url: "alldev.portfolio.io",
    description: t.portfolio.descriptionProject,
    features: [
      { title: t.portfolio.features.responsive.title, desc: t.portfolio.features.responsive.desc, icon: "layout" },
      { title: t.portfolio.features.semantic.title, desc: t.portfolio.features.semantic.desc, icon: "code-2" },
      { title: t.portfolio.features.scrollspy.title, desc: t.portfolio.features.scrollspy.desc, icon: "zap" },
      { title: t.portfolio.features.utilityCss.title, desc: t.portfolio.features.utilityCss.desc, icon: "palette" },
    ],
    tech: ["HTML5", "CSS3", "JavaScript", "Tailwind CSS"],
    liveDemoUrl: "#home",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.rentalTitle,
    badge: t.portfolio.rentalBadge,
    image: rentalImage,
    url: "rental-go.io",
    description: t.portfolio.rentalDesc,
    features: [
      { title: t.portfolio.features.catalogTitle, desc: t.portfolio.features.catalogDesc, icon: "car" },
      { title: t.portfolio.features.bookingTitle, desc: t.portfolio.features.bookingDesc, icon: "calendar" },
      { title: t.portfolio.features.adminTitle, desc: t.portfolio.features.adminDesc, icon: "sliders" },
      { title: t.portfolio.features.invoiceTitle, desc: t.portfolio.features.invoiceDesc, icon: "file-text" },
    ],
    tech: ["Laravel", "Tailwind CSS", "MySQL"],
    liveDemoUrl: "https://rental-mobil-rho.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.hotelTitle,
    badge: t.portfolio.hotelBadge,
    image: hotelImage,
    url: "hotel-ui.vercel.app",
    description: t.portfolio.hotelDesc,
    features: [
      { title: t.portfolio.features.hotelRoomTitle, desc: t.portfolio.features.hotelRoomDesc, icon: "bed" },
      { title: t.portfolio.features.hotelBookingTitle, desc: t.portfolio.features.hotelBookingDesc, icon: "calendar" },
      { title: t.portfolio.features.hotelGalleryTitle, desc: t.portfolio.features.hotelGalleryDesc, icon: "image" },
      { title: t.portfolio.features.hotelResponsiveTitle, desc: t.portfolio.features.hotelResponsiveDesc, icon: "layout" },
    ],
    tech: ["React", "Tailwind CSS", "Vite"],
    liveDemoUrl: "https://hotel-ui-l2f8.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.barberTitle,
    badge: t.portfolio.barberBadge,
    image: barberImage,
    url: "barber-492x.vercel.app",
    description: t.portfolio.barberDesc,
    features: [
      { title: "Reservasi Online", desc: "Pemesanan jadwal barbershop online.", icon: "calendar" },
      { title: "Katalog Layanan", desc: "Layanan potong rambut & perawatan pria.", icon: "scissors" },
    ],
    tech: ["Astro", "Tailwind CSS", "TypeScript"],
    liveDemoUrl: "https://barber-492x.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.ramadhanTitle,
    badge: t.portfolio.ramadhanBadge,
    image: ramadhanImage,
    url: "ramadhan-app-puce.vercel.app",
    description: t.portfolio.ramadhanDesc,
    features: [
      { title: "Jadwal Sholat", desc: "Jadwal imsakiyah & ibadah harian.", icon: "clock" },
      { title: "Jurnal Ibadah", desc: "Pencatatan aktivitas ibadah.", icon: "book-open" },
    ],
    tech: ["Next.js", "Tailwind CSS", "PostgreSQL"],
    liveDemoUrl: "https://ramadhan-app-puce.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  }
];
---

<!-- 5. PORTFOLIO SECTION (KARYA TERBAIK) -->
<section id="portfolio" class="py-24 bg-transparent relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 w-full">
    <!-- Header Row (Matches Mockup) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-4 max-w-xl" data-aos="fade-right">
        <h2 class="text-sm font-bold text-primary uppercase tracking-widest mb-1">{t.portfolio.title}</h2>
        <h3 class="text-4xl md:text-5xl font-black tracking-tight py-2 leading-snug">
          <span class="heading-timbul-blue">{lang === 'id' ? 'Karya Unggulan.' : 'Featured Works.'}</span>
        </h3>
        <p class="text-slate-500 text-base md:text-lg leading-relaxed">
          {t.portfolio.description}
        </p>
      </div>

      <!-- Controls (Top Right - Matches Mockup) -->
      <div class="flex items-center gap-3" data-aos="fade-left">
        <button id="portfolio-prev" class="btn-3d-circle w-12 h-12 shadow-sm disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300" aria-label="Previous Project">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button id="portfolio-next" class="btn-3d-circle w-12 h-12 shadow-sm disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300" aria-label="Next Project">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- Smooth Scroll Slider -->
    <div class="relative w-full" data-aos="fade-up" data-aos-delay="200">
      <div id="portfolio-slider" class="portfolio-slider flex gap-6 pb-6 cursor-grab select-none">
        {projects.map((project, idx) => (
          <div class="portfolio-card shrink-0" data-slide-index={idx}>
            <!-- 3D Convex Project Card -->
            <div class="project-card-3d group flex flex-col h-full rounded-[2.25rem] overflow-hidden">
              
              <!-- Top Image Showcase Area with 3D Specular Highlight -->
              <div class="relative w-full overflow-hidden bg-slate-900 aspect-[16/10] border-b border-slate-100/80">
                <Image
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out pointer-events-none"
                  widths={[420, 840]}
                  sizes="(max-width: 1024px) 100vw, 420px"
                />
                <!-- Gradient Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/65 via-transparent to-black/10 opacity-70 group-hover:opacity-40 transition-opacity duration-500"></div>

                <!-- Specular Highlight Line at top of image -->
                <div class="absolute top-0 inset-x-0 h-[1px] bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none z-20"></div>

                <!-- Top Left Badge Pill (3D Dark Badge) -->
                {project.badge && (
                  <div class="absolute top-4 left-4 z-10">
                    <span class="chip-3d-dark inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold text-white tracking-wide">
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                      {project.badge}
                    </span>
                  </div>
                )}

                <!-- Top Right Live URL Chip (3D White Chip) -->
                {project.url && (
                  <div class="absolute top-4 right-4 z-10">
                    <a href={project.liveDemoUrl} target="_blank" rel="noopener noreferrer" class="chip-3d-url inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold text-slate-700 hover:text-blue-600 transition-all">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping opacity-75"></span>
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 -ml-3"></span>
                      {project.url}
                    </a>
                  </div>
                )}

                <!-- Hover Action Quick Button Overlay (Center) -->
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 z-10 bg-slate-900/35 backdrop-blur-[2px]">
                  <a href={project.liveDemoUrl} target="_blank" rel="noopener noreferrer" class="btn-3d-blue btn-3d-sm transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 group/btn">
                    <span>{t.portfolio.liveDemo}</span>
                  </a>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-6 md:p-7 flex flex-col flex-grow justify-between gap-6">
                <div class="space-y-3">
                  <h4 class="text-xl md:text-2xl font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors duration-300 tracking-tight leading-snug">
                    {project.title}
                  </h4>
                  <p class="text-slate-500 text-sm leading-relaxed line-clamp-3 font-medium">
                    {project.description}
                  </p>
                </div>

                <!-- Divider with gradient accent -->
                <div class="h-[1px] bg-gradient-to-r from-transparent via-slate-200 to-transparent w-full"></div>

                <!-- Tech Badges & Action Link Footer -->
                <div class="space-y-4">
                  <!-- 3D Tech Badges -->
                  <div class="flex flex-wrap gap-2">
                    {project.tech.map((tItem) => (
                      <span class="tech-pill-3d inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold text-slate-700 transition-colors">
                        {tItem === "HTML5" || tItem === "HTML" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
                        ) : tItem === "CSS3" || tItem === "CSS" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                        ) : tItem === "JavaScript" || tItem === "JS" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                        ) : tItem === "Laravel" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                        ) : tItem === "Tailwind CSS" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
                        ) : tItem === "MySQL" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-700"></span>
                        ) : tItem === "React" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                        ) : tItem === "Vite" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                        ) : tItem === "Astro" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-orange-600"></span>
                        ) : tItem === "TypeScript" || tItem === "TS" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                        ) : tItem === "Next.js" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-slate-900"></span>
                        ) : tItem === "PostgreSQL" ? (
                          <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                        ) : (
                          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                        )}
                        {tItem}
                      </span>
                    ))}
                  </div>

                  <!-- Footer Action Row -->
                  <div class="flex items-center justify-between pt-1">
                    <a href={project.liveDemoUrl} target="_blank" rel="noopener noreferrer" class="btn-3d-blue btn-3d-sm group/btn">
                      <span>{t.portfolio.liveDemo}</span>
                    </a>

                    {project.sourceCodeUrl && (
                      <a href={project.sourceCodeUrl} target="_blank" rel="noopener noreferrer" aria-label="Source Code" class="btn-3d-circle w-9 h-9 text-slate-500 hover:text-slate-900 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                      </a>
                    )}
                  </div>
                </div>

              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Scroll Progress Dots -->
      <div id="portfolio-dots" class="flex justify-center gap-2 mt-4">
        {projects.map((_, idx) => (
          <button
            class="portfolio-dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 hover:bg-slate-400"
            data-dot-index={idx}
            aria-label={`Go to project ${idx + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     3D CONVEX PROJECT CARD STYLING
     ========================================================================= */
  .project-card-3d {
    background: linear-gradient(180deg, #ffffff 0%, #fcfdfd 45%, #f8fafc 100%);
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-top: 1.5px solid #ffffff;
    box-shadow: 
      inset 0 3px 3.5px 0 rgba(255, 255, 255, 1),
      inset 0 -3px 5px 0 rgba(15, 23, 42, 0.03),
      0 12px 32px -8px rgba(15, 23, 42, 0.07),
      0 4px 12px -2px rgba(15, 23, 42, 0.03);
    transition: 
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.45s ease;
    will-change: transform, box-shadow;
  }

  .project-card-3d:hover {
    transform: translateY(-8px);
    border-color: rgba(191, 219, 254, 0.9);
    box-shadow: 
      inset 0 3.5px 4px 0 rgba(255, 255, 255, 1),
      inset 0 -3px 5px 0 rgba(15, 23, 42, 0.02),
      0 24px 50px -12px rgba(37, 99, 235, 0.18),
      0 10px 24px -4px rgba(15, 23, 42, 0.05);
  }

  /* 3D Dark Pill Badge (Top Left of Image) */
  .chip-3d-dark {
    background: linear-gradient(180deg, rgba(30, 41, 59, 0.88) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1.5px 2px 0 rgba(0, 0, 0, 0.5),
      0 4px 12px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* 3D White URL Chip (Top Right of Image) */
  .chip-3d-url {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(241, 245, 249, 0.92) 100%);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 
      inset 0 1.5px 2px 0 #ffffff,
      inset 0 -1px 2px 0 rgba(0, 0, 0, 0.04),
      0 4px 10px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .chip-3d-url:hover {
    background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
    border-color: #bfdbfe;
    box-shadow: 
      inset 0 1.5px 2px 0 #ffffff,
      0 6px 14px rgba(37, 99, 235, 0.15);
    transform: translateY(-1px);
  }

  /* 3D Tech Badges / Pills */
  .tech-pill-3d {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 50%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    box-shadow: 
      inset 0 1.5px 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 1px 0 rgba(15, 23, 42, 0.03),
      0 1px 3px rgba(15, 23, 42, 0.04);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tech-pill-3d:hover {
    background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
    border-color: #bfdbfe;
    color: #2563eb;
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 1),
      0 2px 6px rgba(37, 99, 235, 0.12);
    transform: translateY(-1px);
  }

  /* Slider Layout & Responsiveness */
  .portfolio-slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none; /* Firefox */
  }
  .portfolio-slider::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
  .portfolio-slider.is-dragging {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
  }
  .portfolio-card {
    scroll-snap-align: start;
    scroll-snap-stop: normal;
    width: 85%;
    min-width: 290px;
    max-width: 420px;
    will-change: transform;
  }
  @media (min-width: 768px) {
    .portfolio-card {
      width: calc(50% - 12px);
      max-width: none;
    }
  }
  .portfolio-dot.active {
    background-color: #2563eb;
    width: 1.5rem;
    border-radius: 9999px;
  }
</style>

<script>
  function initPortfolioSlider() {
    const slider = document.getElementById("portfolio-slider");
    const prevBtn = document.getElementById("portfolio-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("portfolio-next") as HTMLButtonElement | null;
    const dots = document.querySelectorAll('.portfolio-dot');
    const cards = document.querySelectorAll('.portfolio-card');

    if (!slider || !prevBtn || !nextBtn || cards.length === 0) return;

    // --- Helper: get card scroll distance ---
    function getScrollStep(): number {
      const card = cards[0] as HTMLElement;
      return card.offsetWidth + 24; // card width + gap
    }

    // --- Helper: get active card index ---
    function getActiveIndex(): number {
      const scrollPos = slider!.scrollLeft;
      const step = getScrollStep();
      return Math.round(scrollPos / step);
    }

    // --- Update UI with rAF throttling ---
    let isTicking = false;
    function updateUI() {
      if (!slider || !prevBtn || !nextBtn) return;
      const idx = getActiveIndex();
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      prevBtn.disabled = slider.scrollLeft <= 4;
      nextBtn.disabled = slider.scrollLeft >= maxScroll - 4;

      prevBtn.classList.toggle("opacity-40", prevBtn.disabled);
      prevBtn.classList.toggle("cursor-not-allowed", prevBtn.disabled);
      nextBtn.classList.toggle("opacity-40", nextBtn.disabled);
      nextBtn.classList.toggle("cursor-not-allowed", nextBtn.disabled);

      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === idx);
      });
      isTicking = false;
    }

    function onSliderScroll() {
      if (!isTicking) {
        requestAnimationFrame(updateUI);
        isTicking = true;
      }
    }

    slider.addEventListener('scroll', onSliderScroll, { passive: true });

    // --- Button navigation ---
    prevBtn.addEventListener("click", () => {
      slider!.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener("click", () => {
      slider!.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });

    // --- Dot click ---
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        slider!.scrollTo({ left: i * getScrollStep(), behavior: 'smooth' });
      });
    });

    // --- Desktop Mouse Dragging ONLY (Touch uses native 120fps hardware acceleration) ---
    let isMouseDown = false;
    let mouseStartX = 0;
    let mouseScrollStart = 0;
    let mouseMoved = false;

    slider.addEventListener('mousedown', (e) => {
      isMouseDown = true;
      mouseMoved = false;
      mouseStartX = e.clientX;
      mouseScrollStart = slider.scrollLeft;
      slider.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isMouseDown) return;
      const diff = e.clientX - mouseStartX;
      if (Math.abs(diff) > 4) mouseMoved = true;
      slider.scrollLeft = mouseScrollStart - diff;
    });

    window.addEventListener('mouseup', () => {
      if (!isMouseDown) return;
      isMouseDown = false;
      slider.classList.remove('is-dragging');
    });

    slider.addEventListener('click', (e) => {
      if (mouseMoved) {
        e.preventDefault();
        e.stopPropagation();
        mouseMoved = false;
      }
    }, true);

    updateUI();
  }

  initPortfolioSlider();
  document.addEventListener("astro:page-load", initPortfolioSlider);
</script>


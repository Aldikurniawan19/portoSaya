---
import { Image } from 'astro:assets';
import projectImage from '../assets/projek1.png';
import rentalImage from '../assets/rentalimg.png';
import hotelImage from '../assets/projek2.png';
import barberImage from '../assets/projek3.png';
import ramadhanImage from '../assets/projek4.png';
import { getTranslations } from '../i18n/translations';

const lang = Astro.currentLocale || 'id';
const t = getTranslations(lang);

const projects = [
  {
    title: "All.Dev - Modern Developer Portfolio",
    badge: t.portfolio.badge,
    image: projectImage,
    url: "alldev.portfolio.io",
    description: t.portfolio.descriptionProject,
    features: [
      { title: t.portfolio.features.responsive.title, desc: t.portfolio.features.responsive.desc, icon: "layout" },
      { title: t.portfolio.features.semantic.title, desc: t.portfolio.features.semantic.desc, icon: "code-2" },
      { title: t.portfolio.features.scrollspy.title, desc: t.portfolio.features.scrollspy.desc, icon: "zap" },
      { title: t.portfolio.features.utilityCss.title, desc: t.portfolio.features.utilityCss.desc, icon: "palette" },
    ],
    tech: ["HTML5", "CSS3", "JavaScript", "Tailwind CSS"],
    liveDemoUrl: "#home",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.rentalTitle,
    badge: t.portfolio.rentalBadge,
    image: rentalImage,
    url: "rental-go.io",
    description: t.portfolio.rentalDesc,
    features: [
      { title: t.portfolio.features.catalogTitle, desc: t.portfolio.features.catalogDesc, icon: "car" },
      { title: t.portfolio.features.bookingTitle, desc: t.portfolio.features.bookingDesc, icon: "calendar" },
      { title: t.portfolio.features.adminTitle, desc: t.portfolio.features.adminDesc, icon: "sliders" },
      { title: t.portfolio.features.invoiceTitle, desc: t.portfolio.features.invoiceDesc, icon: "file-text" },
    ],
    tech: ["Laravel", "Tailwind CSS", "MySQL"],
    liveDemoUrl: "https://rental-mobil-rho.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.hotelTitle,
    badge: t.portfolio.hotelBadge,
    image: hotelImage,
    url: "hotel-ui.vercel.app",
    description: t.portfolio.hotelDesc,
    features: [
      { title: t.portfolio.features.hotelRoomTitle, desc: t.portfolio.features.hotelRoomDesc, icon: "bed" },
      { title: t.portfolio.features.hotelBookingTitle, desc: t.portfolio.features.hotelBookingDesc, icon: "calendar" },
      { title: t.portfolio.features.hotelGalleryTitle, desc: t.portfolio.features.hotelGalleryDesc, icon: "image" },
      { title: t.portfolio.features.hotelResponsiveTitle, desc: t.portfolio.features.hotelResponsiveDesc, icon: "layout" },
    ],
    tech: ["React", "Tailwind CSS", "Vite"],
    liveDemoUrl: "https://hotel-ui-l2f8.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.barberTitle,
    badge: t.portfolio.barberBadge,
    image: barberImage,
    url: "barber-492x.vercel.app",
    description: t.portfolio.barberDesc,
    features: [
      { title: "Reservasi Online", desc: "Pemesanan jadwal barbershop online.", icon: "calendar" },
      { title: "Katalog Layanan", desc: "Layanan potong rambut & perawatan pria.", icon: "scissors" },
    ],
    tech: ["Astro", "Tailwind CSS", "TypeScript"],
    liveDemoUrl: "https://barber-492x.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  },
  {
    title: t.portfolio.ramadhanTitle,
    badge: t.portfolio.ramadhanBadge,
    image: ramadhanImage,
    url: "ramadhan-app-puce.vercel.app",
    description: t.portfolio.ramadhanDesc,
    features: [
      { title: "Jadwal Sholat", desc: "Jadwal imsakiyah & ibadah harian.", icon: "clock" },
      { title: "Jurnal Ibadah", desc: "Pencatatan aktivitas ibadah.", icon: "book-open" },
    ],
    tech: ["Next.js", "Tailwind CSS", "PostgreSQL"],
    liveDemoUrl: "https://ramadhan-app-puce.vercel.app/",
    sourceCodeUrl: "https://github.com/Aldikurniawan19",
  }
];
---

<!-- 5. PORTFOLIO SECTION (KARYA TERBAIK) -->
<section id="portfolio" class="py-24 bg-white relative overflow-hidden">
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-30 -z-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-50/40 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-6xl mx-auto px-6 w-full">
    <!-- Header Row (Matches Mockup) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-4 max-w-xl" data-aos="fade-right">
        <h2 class="text-sm font-bold text-primary uppercase tracking-widest mb-1">{t.portfolio.title}</h2>
        <h3 class="text-4xl md:text-5xl font-extrabold text-secondary tracking-tight">
          {lang === 'id' ? 'Karya' : 'Featured'} <span class="text-blue-600">{lang === 'id' ? 'Unggulan.' : 'Works.'}</span>
        </h3>
        <p class="text-slate-500 text-base md:text-lg leading-relaxed">
          {t.portfolio.description}
        </p>
      </div>

      <!-- Controls (Top Right - Matches Mockup) -->
      <div class="flex items-center gap-3" data-aos="fade-left">
        <button id="portfolio-prev" class="w-12 h-12 rounded-full border border-slate-200 bg-white hover:bg-slate-50 text-slate-400 hover:text-secondary flex items-center justify-center shadow-sm disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button id="portfolio-next" class="w-12 h-12 rounded-full border border-slate-200 bg-white hover:bg-slate-50 text-slate-400 hover:text-secondary flex items-center justify-center shadow-sm disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- Smooth Scroll Slider -->
    <div class="relative w-full" data-aos="fade-up" data-aos-delay="200">
      <div id="portfolio-slider" class="portfolio-slider flex gap-6 pb-6 cursor-grab select-none">
        {projects.map((project, idx) => (
          <div class="portfolio-card shrink-0" data-slide-index={idx}>
            <!-- Outer Card Container with Gradient Border & Glow -->
            <div class="h-full rounded-[2.25rem] p-[1px] bg-gradient-to-b from-slate-200/80 via-slate-100 to-slate-200/60 hover:from-blue-500/50 hover:via-indigo-500/40 hover:to-blue-500/30 transition-all duration-500 group shadow-[0_8px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_45px_-12px_rgba(37,99,235,0.15)] hover:-translate-y-2">
              
              <!-- Inner Card Wrapper -->
              <div class="bg-white/95 backdrop-blur-sm rounded-[2.2rem] overflow-hidden flex flex-col h-full">
                
                <!-- Top Image Showcase Area -->
                <div class="relative w-full overflow-hidden bg-slate-900 aspect-[16/10]">
                  <Image
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out pointer-events-none"
                    widths={[420, 840]}
                    sizes="(max-width: 1024px) 100vw, 420px"
                  />
                  <!-- Gradient Overlay -->
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-black/10 opacity-70 group-hover:opacity-40 transition-opacity duration-500"></div>

                  <!-- Top Left Badge Pill -->
                  {project.badge && (
                    <div class="absolute top-4 left-4 z-10">
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-900/85 backdrop-blur-md border border-white/20 rounded-full text-[11px] font-bold text-white tracking-wide shadow-lg">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                        {project.badge}
                      </span>
                    </div>
                  )}

                  <!-- Top Right Live URL Chip -->
                  {project.url && (
                    <div class="absolute top-4 right-4 z-10">
                      <a href={project.liveDemoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/90 backdrop-blur-md border border-slate-200/80 rounded-full text-[11px] font-semibold text-slate-700 hover:text-blue-600 hover:bg-white transition-all shadow-md">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping opacity-75"></span>
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 -ml-3"></span>
                        {project.url}
                      </a>
                    </div>
                  )}

                  <!-- Hover Action Quick Button Overlay (Center) -->
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 z-10 bg-slate-900/30 backdrop-blur-[2px]">
                    <a href={project.liveDemoUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-white text-slate-900 hover:bg-blue-600 hover:text-white rounded-full text-xs font-extrabold shadow-xl backdrop-blur-md transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                      {t.portfolio.liveDemo}
                    </a>
                  </div>
                </div>

                <!-- Card Body -->
                <div class="p-6 md:p-7 flex flex-col flex-grow justify-between gap-6">
                  <div class="space-y-3">
                    <h4 class="text-xl md:text-2xl font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors duration-300 tracking-tight leading-snug">
                      {project.title}
                    </h4>
                    <p class="text-slate-500 text-sm leading-relaxed line-clamp-3 font-medium">
                      {project.description}
                    </p>
                  </div>

                  <!-- Divider with gradient glow accent -->
                  <div class="h-[1px] bg-gradient-to-r from-slate-100 via-slate-200 to-slate-100 w-full"></div>

                  <!-- Tech Badges & Action Link Footer -->
                  <div class="space-y-4">
                    <!-- Tech Badges -->
                    <div class="flex flex-wrap gap-2">
                      {project.tech.map((tItem) => (
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100/80 border border-slate-200/60 rounded-full text-xs font-bold text-slate-700 hover:bg-blue-50/80 hover:border-blue-200 transition-colors">
                          {tItem === "HTML5" || tItem === "HTML" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
                          ) : tItem === "CSS3" || tItem === "CSS" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                          ) : tItem === "JavaScript" || tItem === "JS" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                          ) : tItem === "Laravel" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                          ) : tItem === "Tailwind CSS" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
                          ) : tItem === "MySQL" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-700"></span>
                          ) : tItem === "React" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                          ) : tItem === "Vite" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                          ) : tItem === "Astro" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-orange-600"></span>
                          ) : tItem === "TypeScript" || tItem === "TS" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                          ) : tItem === "Next.js" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-900"></span>
                          ) : tItem === "PostgreSQL" ? (
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                          ) : (
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                          )}
                          {tItem}
                        </span>
                      ))}
                    </div>

                    <!-- Footer Action Row -->
                    <div class="flex items-center justify-between pt-1">
                      <a href={project.liveDemoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-extrabold text-blue-600 hover:text-blue-700 group/link transition-colors">
                        <span>{t.portfolio.liveDemo}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transform group-hover/link:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                      </a>

                      {project.sourceCodeUrl && (
                        <a href={project.sourceCodeUrl} target="_blank" rel="noopener noreferrer" aria-label="Source Code" class="p-2 text-slate-400 hover:text-slate-900 hover:bg-slate-100 rounded-full transition-all">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                        </a>
                      )}
                    </div>
                  </div>

                </div>

              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Scroll Progress Dots -->
      <div id="portfolio-dots" class="flex justify-center gap-2 mt-4">
        {projects.map((_, idx) => (
          <button
            class="portfolio-dot w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-300 hover:bg-slate-400"
            data-dot-index={idx}
            aria-label={`Go to project ${idx + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .portfolio-slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  .portfolio-slider::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
  .portfolio-slider.is-dragging {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
  }
  .portfolio-card {
    scroll-snap-align: start;
    width: 85%;
    min-width: 300px;
    max-width: 420px;
  }
  @media (min-width: 768px) {
    .portfolio-card {
      width: calc(50% - 12px);
      max-width: none;
    }
  }
  .portfolio-dot.active {
    background-color: #2563eb;
    width: 1.5rem;
    border-radius: 9999px;
  }
</style>

<script>
  function initPortfolioSlider() {
    const slider = document.getElementById("portfolio-slider");
    const prevBtn = document.getElementById("portfolio-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("portfolio-next") as HTMLButtonElement | null;
    const dots = document.querySelectorAll('.portfolio-dot');
    const cards = document.querySelectorAll('.portfolio-card');

    if (!slider || !prevBtn || !nextBtn || cards.length === 0) return;

    // --- Momentum Drag State ---
    let isDragging = false;
    let startX = 0;
    let scrollStart = 0;
    let dragMoved = false;
    let velocityX = 0;
    let lastX = 0;
    let lastTime = 0;
    let momentumId: number | null = null;

    // --- Helper: get card scroll distance ---
    function getScrollStep(): number {
      const card = cards[0] as HTMLElement;
      return card.offsetWidth + 24; // card width + gap
    }

    // --- Helper: get active card index ---
    function getActiveIndex(): number {
      const scrollPos = slider!.scrollLeft;
      const step = getScrollStep();
      return Math.round(scrollPos / step);
    }

    // --- Update UI (buttons + dots) ---
    function updateUI() {
      if (!slider || !prevBtn || !nextBtn) return;
      const idx = getActiveIndex();
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      prevBtn.disabled = slider.scrollLeft <= 2;
      nextBtn.disabled = slider.scrollLeft >= maxScroll - 2;

      prevBtn.classList.toggle("opacity-40", prevBtn.disabled);
      prevBtn.classList.toggle("cursor-not-allowed", prevBtn.disabled);
      nextBtn.classList.toggle("opacity-40", nextBtn.disabled);
      nextBtn.classList.toggle("cursor-not-allowed", nextBtn.disabled);

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === idx);
      });
    }

    // --- Button scroll ---
    prevBtn.addEventListener("click", () => {
      slider!.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener("click", () => {
      slider!.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });

    // --- Dot click ---
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        slider!.scrollTo({ left: i * getScrollStep(), behavior: 'smooth' });
      });
    });

    // --- Scroll event (update UI on any scroll) ---
    let scrollTimer: ReturnType<typeof setTimeout>;
    slider.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(updateUI, 50);
    }, { passive: true });

    // --- Momentum physics ---
    function applyMomentum() {
      if (Math.abs(velocityX) < 0.5) {
        momentumId = null;
        // After momentum stops, let snap take over
        slider!.classList.remove('is-dragging');
        return;
      }
      slider!.scrollLeft -= velocityX;
      velocityX *= 0.92; // friction
      momentumId = requestAnimationFrame(applyMomentum);
    }

    function stopMomentum() {
      if (momentumId !== null) {
        cancelAnimationFrame(momentumId);
        momentumId = null;
      }
    }

    // --- Drag handlers ---
    function pointerDown(e: MouseEvent | TouchEvent) {
      stopMomentum();
      isDragging = true;
      dragMoved = false;
      const x = 'touches' in e ? e.touches[0].clientX : e.clientX;
      startX = x;
      lastX = x;
      lastTime = Date.now();
      scrollStart = slider!.scrollLeft;
      velocityX = 0;
      slider!.classList.add('is-dragging');
    }

    function pointerMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      const x = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const diff = x - startX;
      if (Math.abs(diff) > 5) dragMoved = true;

      // Track velocity
      const now = Date.now();
      const dt = now - lastTime;
      if (dt > 0) {
        velocityX = (x - lastX) / dt * 16; // normalize to ~60fps
        lastX = x;
        lastTime = now;
      }

      slider!.scrollLeft = scrollStart - diff;
    }

    function pointerUp() {
      if (!isDragging) return;
      isDragging = false;

      // Apply momentum if fast enough
      if (Math.abs(velocityX) > 1) {
        momentumId = requestAnimationFrame(applyMomentum);
      } else {
        slider!.classList.remove('is-dragging');
      }
    }

    // Prevent link clicks after drag
    slider.addEventListener('click', (e) => {
      if (dragMoved) {
        e.preventDefault();
        e.stopPropagation();
        dragMoved = false;
      }
    }, true);

    // Mouse events
    slider.addEventListener('mousedown', pointerDown);
    window.addEventListener('mousemove', pointerMove);
    window.addEventListener('mouseup', pointerUp);

    // Touch events
    slider.addEventListener('touchstart', pointerDown, { passive: true });
    slider.addEventListener('touchmove', pointerMove, { passive: true });
    slider.addEventListener('touchend', pointerUp);

    // Initial UI
    updateUI();
  }

  // Boot
  initPortfolioSlider();
  document.addEventListener("astro:page-load", initPortfolioSlider);
</script>


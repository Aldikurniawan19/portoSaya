---
import { getTranslations } from "../i18n/translations";
import SplashScreen from "../components/SplashScreen.astro";

interface Props {
  title?: string;
  description?: string;
}

const lang = Astro.currentLocale || "id";
const t = getTranslations(lang);

const { title = t.meta.title, description = t.meta.description } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Tailwind CSS CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Lucide Icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <!-- AOS Scroll Animations Style -->
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />

    <!-- Custom Tailwind Config -->
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', "sans-serif"],
            },
            colors: {
              primary: "#4f46e5",
              secondary: "#0f172a",
              accent: "#6366f1",
            },
            backgroundImage: {
              "grid-pattern":
                "linear-gradient(to right, #f1f5f9 1px, transparent 1px), linear-gradient(to bottom, #f1f5f9 1px, transparent 1px)",
              "grid-pattern-dark":
                "linear-gradient(to right, rgba(255, 255, 255, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 1px, transparent 1px)",
            },
          },
        },
      };
    </script>

    <style is:inline>
      /* Prevent AOS animation flash on slow connections */
      html:not(.no-js) [data-aos] {
        opacity: 0;
        transition-property: opacity, transform;
      }
    </style>
  </head>
  <body
    class="bg-white text-slate-600 antialiased selection:bg-primary selection:text-white overflow-x-hidden"
  >
    <SplashScreen />
    <slot />

    <!-- AOS Scroll Animations -->
    <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>

    <!-- Logic initialization -->
    <script is:inline>
      // 1. Initialize Lucide Icons once
      let lucideInitialized = false;
      function initLucide() {
        if (lucideInitialized) return;
        if (typeof lucide !== "undefined") {
          lucide.createIcons();
          lucideInitialized = true;
        }
      }
      document.addEventListener("DOMContentLoaded", initLucide);
      window.addEventListener("load", initLucide);
      document.addEventListener("astro:page-load", () => {
        lucideInitialized = false;
        initLucide();
      });

      // 2. Initialize AOS Animations with mobile performance tuning
      if (typeof AOS !== "undefined") {
        AOS.init({
          duration: 700,
          easing: "ease-out-cubic",
          once: true,
          offset: 40,
          delay: 0,
          disableMutationObserver: true,
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ========================================================
     GLOBAL 3D TIMBUL FONT STYLING (FOR SECTION HEADINGS)
     ======================================================== */
  .heading-timbul-dark,
  .text-timbul-slate,
  .hero-name-timbul,
  .about-badge-timbul {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #475569 0%, #1e293b 35%, #0f172a 75%, #020617 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(15, 23, 42, 0.6))
      drop-shadow(3px 4.5px 2px rgba(15, 23, 42, 0.45))
      drop-shadow(0 14px 26px rgba(15, 23, 42, 0.25));
    cursor: default;
    user-select: none;
  }

  .heading-timbul-blue,
  .text-timbul-blue,
  .hero-name-timbul-blue,
  .about-name-timbul-blue {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #93c5fd 0%, #3b82f6 25%, #2563eb 60%, #1d4ed8 85%, #172554 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(30, 58, 138, 0.7))
      drop-shadow(3px 4.5px 2px rgba(29, 78, 216, 0.55))
      drop-shadow(0 16px 30px rgba(37, 99, 235, 0.45));
    cursor: default;
    user-select: none;
  }

  .heading-timbul-dot,
  .text-timbul-dot,
  .hero-name-dot {
    display: inline-block;
    padding-top: 0.15em;
    padding-bottom: 0.32em;
    margin-top: -0.15em;
    margin-bottom: -0.32em;
    padding-right: 0.08em;
    padding-left: 0.04em;
    line-height: normal;
    background: linear-gradient(180deg, #93c5fd 0%, #3b82f6 25%, #2563eb 60%, #1d4ed8 85%, #172554 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: 
      drop-shadow(0 -2px 0.8px rgba(255, 255, 255, 1))
      drop-shadow(1.5px 2px 0px rgba(30, 58, 138, 0.7))
      drop-shadow(3px 4.5px 2px rgba(29, 78, 216, 0.55));
  }

  /* Glass Navbar Update */
  .glass-nav {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
  }

  /* Grid Background Styling */
  .bg-grid {
    background-size: 40px 40px;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      10%,
      black,
      90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      5%,
      black,
      95%,
      transparent
    );
  }

  /* GPU-Accelerated Dynamic Laser Beams */
  @keyframes beam-h {
    0% {
      transform: translate3d(-180px, 0, 0);
    }
    100% {
      transform: translate3d(calc(100vw + 180px), 0, 0);
    }
  }

  @keyframes beam-h-reverse {
    0% {
      transform: translate3d(calc(100vw + 180px), 0, 0);
    }
    100% {
      transform: translate3d(-180px, 0, 0);
    }
  }

  @keyframes beam-v {
    0% {
      transform: translate3d(0, -180px, 0);
    }
    100% {
      transform: translate3d(0, calc(100% + 180px), 0);
    }
  }

  @keyframes beam-v-reverse {
    0% {
      transform: translate3d(0, calc(100% + 180px), 0);
    }
    100% {
      transform: translate3d(0, -180px, 0);
    }
  }

  /* Parallax Layer Optimizations */
  .parallax-layer {
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  html {
    scroll-padding-top: 80px;
  }

  /* Animation for code cursor */
  .cursor-blink {
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* Marquee Slider Animation Styles (GPU Accelerated) */
  @keyframes scroll-left {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  .animate-scroll-left {
    animation: scroll-left 28s linear infinite;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .animate-scroll-right {
    animation: scroll-right 28s linear infinite;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .marquee-wrapper {
    display: flex;
    overflow: hidden;
    user-select: none;
    position: relative;
    width: 100%;
    contain: layout paint;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .marquee-group {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-shrink: 0;
    gap: 2.25rem;
    padding-right: 2.25rem;
    min-width: 100%;
  }

  /* Pause on hover */
  @media (hover: hover) {
    .marquee-wrapper:hover .animate-scroll-left,
    .marquee-wrapper:hover .animate-scroll-right {
      animation-play-state: paused;
    }
  }

  /* ==========================================================================
     3D CONVEX ROUNDED BUTTONS (Desain 3D Cembung Bulat)
     ========================================================================== */

  /* Primary Blue 3D Convex Pill Button (Matches User Reference Image) */
  .btn-3d-blue {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 9999px;
    font-weight: 700;
    color: #ffffff !important;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    isolation: isolate;
    
    /* Convex 3D Gradient Base */
    background: linear-gradient(180deg, #4d8df7 0%, #2b6cef 45%, #1d4ed8 100%);
    border: 1px solid rgba(255, 255, 255, 0.35);
    
    /* 3D Convex Lighting: Specular Top Highlight + Bottom Ambient Shadow + Elevation Shadow */
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.7),
      inset 0 -2.5px 3.5px 0 rgba(10, 30, 95, 0.45),
      0 6px 16px -2px rgba(29, 78, 216, 0.45),
      0 3px 6px -1px rgba(15, 23, 42, 0.25);
    
    text-shadow: 0 1px 2px rgba(10, 35, 90, 0.4);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-3d-blue:hover {
    background: linear-gradient(180deg, #609bf9 0%, #3b7bf6 45%, #2563eb 100%);
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 0.85),
      inset 0 -2px 3px 0 rgba(10, 30, 95, 0.35),
      0 10px 25px -3px rgba(37, 99, 235, 0.6),
      0 4px 10px -1px rgba(15, 23, 42, 0.3);
    transform: translateY(-2px) scale(1.02);
    color: #ffffff !important;
  }

  .btn-3d-blue:active {
    background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 55%, #1e40af 100%);
    box-shadow: 
      inset 0 3px 5px 0 rgba(0, 0, 0, 0.4),
      inset 0 -1px 1.5px 0 rgba(255, 255, 255, 0.2),
      0 2px 6px 0 rgba(29, 78, 216, 0.35);
    transform: translateY(1.5px) scale(0.98);
  }

  /* Dark / Slate 3D Convex Pill Button */
  .btn-3d-dark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 9999px;
    font-weight: 700;
    color: #ffffff !important;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    
    background: linear-gradient(180deg, #334155 0%, #1e293b 50%, #0f172a 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.4),
      inset 0 -2.5px 3.5px 0 rgba(0, 0, 0, 0.6),
      0 6px 16px -2px rgba(15, 23, 42, 0.35),
      0 3px 6px -1px rgba(0, 0, 0, 0.2);
      
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-3d-dark:hover {
    background: linear-gradient(180deg, #475569 0%, #334155 50%, #1e293b 100%);
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 0.55),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.5),
      0 10px 24px -3px rgba(15, 23, 42, 0.5),
      0 4px 8px -1px rgba(0, 0, 0, 0.25);
    transform: translateY(-2px) scale(1.02);
    color: #ffffff !important;
  }

  .btn-3d-dark:active {
    background: linear-gradient(180deg, #0f172a 0%, #020617 100%);
    box-shadow: 
      inset 0 3px 5px 0 rgba(0, 0, 0, 0.7),
      inset 0 -1px 1.5px 0 rgba(255, 255, 255, 0.1),
      0 2px 6px 0 rgba(0, 0, 0, 0.3);
    transform: translateY(1.5px) scale(0.98);
  }

  /* Light / White 3D Convex Pill Button */
  .btn-3d-light {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 9999px;
    font-weight: 700;
    color: #1e293b !important;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 45%, #e2e8f0 100%);
    border: 1px solid rgba(203, 213, 225, 0.85);
    
    box-shadow: 
      inset 0 2px 2px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.08),
      0 6px 14px -2px rgba(0, 0, 0, 0.08),
      0 2px 4px -1px rgba(0, 0, 0, 0.05);
      
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-3d-light:hover {
    background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 45%, #cbd5e1 100%);
    border-color: #94a3b8;
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.12),
      0 10px 20px -3px rgba(0, 0, 0, 0.12),
      0 4px 6px -1px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px) scale(1.02);
    color: #0f172a !important;
  }

  .btn-3d-light:active {
    background: linear-gradient(180deg, #e2e8f0 0%, #cbd5e1 100%);
    box-shadow: 
      inset 0 3px 5px 0 rgba(0, 0, 0, 0.18),
      0 2px 4px 0 rgba(0, 0, 0, 0.06);
    transform: translateY(1.5px) scale(0.98);
  }

  /* Compact / Small 3D Convex Button Variant */
  .btn-3d-sm {
    padding: 0.45rem 1.15rem !important;
    font-size: 0.8125rem !important;
    gap: 0.375rem !important;
  }

  /* Circular 3D Convex Button (e.g., slider arrows) */
  .btn-3d-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 45%, #e2e8f0 100%);
    border: 1px solid rgba(203, 213, 225, 0.85);
    box-shadow: 
      inset 0 2px 2px 0 rgba(255, 255, 255, 1),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.08),
      0 4px 10px -1px rgba(0, 0, 0, 0.08);
    color: #475569;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-3d-circle:hover:not(:disabled) {
    background: linear-gradient(180deg, #4d8df7 0%, #2b6cef 45%, #1d4ed8 100%);
    border-color: rgba(255, 255, 255, 0.4);
    color: #ffffff;
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.7),
      inset 0 -2px 3px 0 rgba(10, 30, 95, 0.4),
      0 8px 20px -2px rgba(37, 99, 235, 0.5);
    transform: translateY(-2px) scale(1.05);
  }

  .btn-3d-circle:active:not(:disabled) {
    transform: translateY(1.5px) scale(0.96);
    box-shadow: 
      inset 0 2px 4px 0 rgba(0, 0, 0, 0.3),
      0 2px 4px 0 rgba(0, 0, 0, 0.1);
  }

  /* =========================================================================
     3D CONVEX CARDS & ELEMENTS
     ========================================================================= */

  /* 3D Convex Gradient Card (e.g., Get In Touch Card) */
  .card-3d-blue {
    position: relative;
    background: linear-gradient(170deg, #3b82f6 0%, #2563eb 28%, #1d4ed8 65%, #172554 100%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 0.7),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -4px 8px 0 rgba(10, 25, 75, 0.6),
      0 20px 45px -10px rgba(29, 78, 216, 0.45),
      0 8px 16px -4px rgba(15, 23, 42, 0.25);
  }

  /* 3D Convex Inner Glassmorphic Item Cards */
  .card-3d-item {
    position: relative;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.11) 50%, rgba(255, 255, 255, 0.05) 100%);
    border: 1px solid rgba(255, 255, 255, 0.32);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 
      inset 0 2px 2px 0 rgba(255, 255, 255, 0.65),
      inset 0 -2px 3.5px 0 rgba(10, 25, 75, 0.35),
      0 6px 16px -2px rgba(10, 20, 50, 0.2);
    user-select: none;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.card-3d-item:hover {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0.18) 50%, rgba(255, 255, 255, 0.08) 100%);
    border-color: rgba(255, 255, 255, 0.55);
    box-shadow: 
      inset 0 2.5px 3.5px 0 rgba(255, 255, 255, 0.85),
      inset 0 -2px 3.5px 0 rgba(10, 25, 75, 0.3),
      0 10px 24px -3px rgba(10, 20, 60, 0.35);
    transform: translateY(-2px);
  }

  a.card-3d-item:active {
    transform: translateY(1px) scale(0.99);
    box-shadow: 
      inset 0 3px 5px 0 rgba(0, 0, 0, 0.3),
      0 2px 4px 0 rgba(0, 0, 0, 0.15);
  }

  /* 3D Convex Inner Icon Container */
  .card-3d-item-icon {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.16) 100%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.8),
      inset 0 -1.5px 2px 0 rgba(10, 25, 75, 0.3),
      0 4px 10px rgba(0, 0, 0, 0.15);
  }

  /* 3D Convex Follow Me Social Buttons */
  .social-3d-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    color: #ffffff;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.14) 50%, rgba(255, 255, 255, 0.06) 100%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.75),
      inset 0 -2px 3px 0 rgba(10, 25, 70, 0.4),
      0 4px 10px rgba(0, 0, 0, 0.2);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
  }

  .social-3d-circle:hover {
    background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 45%, #cbd5e1 100%);
    color: #1e293b;
    border-color: #ffffff;
    box-shadow: 
      inset 0 2px 2.5px 0 #ffffff,
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.15),
      0 8px 20px rgba(0, 0, 0, 0.3);
    transform: translateY(-2px) scale(1.1);
  }

  .social-3d-circle:active {
    transform: translateY(1.5px) scale(0.96);
    box-shadow: 
      inset 0 2px 4px 0 rgba(0, 0, 0, 0.3),
      0 2px 4px 0 rgba(0, 0, 0, 0.1);
  }

  /* 3D Convex Dark Circular Button (Footer Socials) */
  .social-3d-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    color: #cbd5e1;
    background: linear-gradient(180deg, #334155 0%, #1e293b 50%, #0f172a 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.35),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.7),
      0 4px 12px -2px rgba(0, 0, 0, 0.5),
      0 2px 4px -1px rgba(0, 0, 0, 0.3);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
  }

  .social-3d-dark:hover {
    background: linear-gradient(180deg, #475569 0%, #334155 50%, #1e293b 100%);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 
      inset 0 2px 2.5px 0 rgba(255, 255, 255, 0.55),
      inset 0 -2px 3px 0 rgba(0, 0, 0, 0.6),
      0 8px 20px -2px rgba(0, 0, 0, 0.6);
    transform: translateY(-2px) scale(1.1);
  }

  .social-3d-dark:active {
    transform: translateY(1.5px) scale(0.96);
